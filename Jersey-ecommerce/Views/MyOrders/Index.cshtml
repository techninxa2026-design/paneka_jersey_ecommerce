@model IReadOnlyList<Jersey_ecommerce.Models.Orders.Order>
@{
    Layout = null;
    ViewData["Title"] = "Your orders";
    var currentPage = (int?)ViewData["Page"] ?? 1;
    var totalPages = (int?)ViewData["TotalPages"] ?? 1;
    var totalOrders = (int?)ViewData["TotalCount"] ?? Model.Count;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Check your PANENKA order history and delivery progress." />
    <title>My orders | PANENKA</title>
    <link rel="stylesheet" href="/css/panenka-checkout.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/panenka-premium.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/panenka-orders.css" asp-append-version="true" />
</head>
<body>
@await Html.PartialAsync("_PanenkaCheckoutHeader")
<section class="container intro">
    <div class="kicker">YOUR ACCOUNT / ORDER HISTORY</div>
    <h1>Your orders.</h1>
    <p class="lead">Every matchday essential, from your bag to your door.</p>
</section>
<main class="container pn-order-wrap">
    <div class="pn-order-top">
        <div><div class="pn-order-eyebrow">Order history</div><h2 style="margin:7px 0 0;font-size:24px;letter-spacing:-.05em">Purchases & delivery progress</h2>
            <span class="pn-order-meta">@totalOrders @(totalOrders == 1 ? "order" : "orders")</span></div>
        <a href="/shop" class="pn-order-action">CONTINUE SHOPPING →</a>
    </div>
    @if (Model.Count == 0)
    {
        <div class="pn-order-card pn-order-empty">
            <h2>Your bag's next adventure starts here.</h2>
            <p>No orders yet. Discover a jersey worth celebrating.</p>
            <a href="/shop">EXPLORE THE COLLECTION →</a>
        </div>
    }
    else
    {
        <div class="pn-order-list">
            @foreach (var order in Model)
            {
                <a class="pn-order-card pn-order-row" asp-area="" asp-controller="MyOrders" asp-action="Details" asp-route-id="@order.Id"
                   aria-label="View order @order.OrderNumber, @order.Status">
                    <div>
                        <strong>@order.OrderNumber</strong>
                        <span class="pn-order-meta">Placed @order.CreatedAt.ToString("dd MMM yyyy") · @order.CustomerName</span>
                        <div class="pn-order-badges">
                            <span class="pn-pill" data-state="@order.Status">Order: @order.Status</span>
                            @if (order.Shipment is not null)
                            {
                                <span class="pn-pill" data-state="@order.Shipment.Status">Delivery: @order.Shipment.Status</span>
                            }
                        </div>
                    </div>
                    <div>
                        <strong>৳@order.TotalAmount.ToString("N2")</strong>
                        <span class="pn-order-meta">Payment: @(order.Payment?.Status ?? "Pending")</span>
                        @if (!string.IsNullOrWhiteSpace(order.Shipment?.TrackingNumber))
                        {
                            <span class="pn-order-meta">Tracking: @order.Shipment.TrackingNumber</span>
                        }
                    </div>
                    <span class="pn-order-arrow" aria-hidden="true">↗</span>
                </a>
            }
        </div>
        @if (totalPages > 1)
        {
            <nav class="pn-order-pagination" aria-label="Order history pages">
                @if (currentPage > 1)
                {
                    <a href="/MyOrders?page=@(currentPage - 1)">← Previous</a>
                }
                <span>Page @currentPage of @totalPages</span>
                @if (currentPage < totalPages)
                {
                    <a href="/MyOrders?page=@(currentPage + 1)">Next →</a>
                }
            </nav>
        }
    }
</main>
@await Html.PartialAsync("_PanenkaCheckoutFooter")
</body>
</html>
