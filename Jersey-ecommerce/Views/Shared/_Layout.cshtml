@{
    var title = ViewData["Title"]?.ToString() ?? "PANENKA";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0d0f" />
    <title>@title | PANENKA</title>
    <link rel="icon" type="image/jpeg" href="~/assets/brands/panekalogo.jpeg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Jersey_ecommerce.styles.css" asp-append-version="true" />
</head>
<body class="panenka-shell">
    <header class="panenka-header">
        <nav class="navbar navbar-expand-lg navbar-dark" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand panenka-wordmark" asp-area="" asp-controller="Home" asp-action="Index" aria-label="PANENKA home">PANENKA<span class="brand-mark">®</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#panenkaNavigation" aria-controls="panenkaNavigation" aria-expanded="false" aria-label="Toggle menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="panenkaNavigation">
                    <ul class="navbar-nav me-auto gap-lg-2">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Shop" asp-action="Index">Shop jerseys</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Wishlist" asp-action="Index">Wishlist</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Cart" asp-action="Index">Bag</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="MyOrders" asp-action="Index">My orders</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Contact">Contact</a></li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <main class="container panenka-main" role="main">
        @RenderBody()
    </main>
    <footer class="panenka-footer">
        <div class="container d-flex flex-wrap align-items-center justify-content-between gap-3">
            <span class="panenka-footer-brand">PANENKA <small>FOOTBALL CULTURE</small></span>
            <div class="d-flex flex-wrap gap-4">
                <a asp-area="" asp-controller="Shop" asp-action="Index">Shop</a>
                <a asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
            <span class="panenka-copyright">© @DateTime.UtcNow.Year PANENKA</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
