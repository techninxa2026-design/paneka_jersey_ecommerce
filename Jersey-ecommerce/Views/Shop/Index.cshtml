    <div class="toast" role="status" aria-live="polite" id="toast"></div>
    <script>
            'use strict';
            // Live storefront: no fake demo products or local-only cart data.
            const SETTINGS = Object.freeze({ api: '/api/storefront/shop', pageSize: 12, productDetailsBase: '' });
            const $ = s => document.querySelector(s), byId = id => document.getElementById(id), icon = n => `<svg aria-hidden="true"><use href="#i-${n}"></use></svg>`;
            const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            const cash = n => '৳ ' + Number(n || 0).toLocaleString('en-BD', { maximumFractionDigits: 0 });
            const read = (o, ...keys) => { for (let k of keys) if (o?.[k] !== undefined && o?.[k] !== null) return o[k]; return undefined };
            const safeImg = url => { if (typeof url !== 'string') return ''; if (url.startsWith('/') && !url.startsWith('//') && !url.includes('\\')) return url; if (/^https:\/\//i.test(url)) return url; if (/^data:image\/(webp|png|jpeg);base64,[A-Za-z0-9+/=]+$/.test(url)) return url; return '' };
            const state = { search: '', categoryId: null, sizeId: null, minPrice: null, maxPrice: null, inStock: false, sort: 'newest', page: 1, items: [], total: 0, totalPages: 1, categories: [], sizes: [], bounds: { min: 0, max: 30000 }, preview: false, busy: false, seq: 0, likes: new Set(), activeProduct: null, pendingCollection: null, collection: null };
            
            const PREVIEW_PHOTOS = [];
            const PREVIEW_PRODUCTS = [];
            function normalize(p) { return { id: String(read(p, 'id', 'Id') ?? ''), name: String(read(p, 'name', 'Name') || 'Football jersey'), slug: String(read(p, 'slug', 'Slug') || ''), category: String(read(p, 'category', 'categoryName', 'CategoryName') || 'Football Jersey'), categoryId: Number(read(p, 'categoryId', 'CategoryId') || 0), price: Number(read(p, 'price', 'Price', 'basePrice') || 0), compareAtPrice: Number(read(p, 'compareAtPrice', 'CompareAtPrice') || 0), stockQuantity: Number(read(p, 'stockQuantity', 'StockQuantity') || 0), imageUrl: safeImg(read(p, 'imageUrl', 'ImageUrl') || ''), isNewArrival: read(p, 'isNewArrival', 'IsNewArrival') === true, isFeatured: read(p, 'isFeatured', 'IsFeatured') === true, description: String(read(p, 'description', 'Description') || ''), availableSizes: (read(p, 'availableSizes', 'AvailableSizes') || []).map(x => ({ id: Number(read(x, 'id', 'Id') || 0), name: String(read(x, 'name', 'Name') || '') })) }; }
            function previewResponse() { let xs = PREVIEW_PRODUCTS.slice(); if (state.search) xs = xs.filter(p => (p.name + ' ' + p.category + ' ' + p.slug).toLowerCase().includes(state.search.toLowerCase())); if (state.categoryId) xs = xs.filter(p => p.categoryId === state.categoryId); if (state.sizeId) xs = xs.filter(p => p.availableSizes.some(z => z.id === state.sizeId)); if (state.minPrice !== null) xs = xs.filter(p => p.price >= state.minPrice); if (state.maxPrice !== null) xs = xs.filter(p => p.price <= state.maxPrice); if (state.inStock) xs = xs.filter(p => p.stockQuantity > 0); if (state.sort === 'price_asc') xs.sort((a, b) => a.price - b.price); else if (state.sort === 'price_desc') xs.sort((a, b) => b.price - a.price); else if (state.sort === 'name') xs.sort((a, b) => a.name.localeCompare(b.name)); else if (state.sort === 'featured') xs.sort((a, b) => Number(b.isFeatured) - Number(a.isFeatured)); const total = xs.length; const pages = Math.max(1, Math.ceil(total / SETTINGS.pageSize)); state.page = Math.min(state.page, pages); return { products: xs.slice((state.page - 1) * SETTINGS.pageSize, state.page * SETTINGS.pageSize), total, page: state.page, totalPages: pages, categories: [{ id: 1, name: 'Player Edition', count: 1 }, { id: 2, name: 'Retro Archive', count: 3 }, { id: 3, name: 'Club Collection', count: 3 }, { id: 4, name: 'National Teams', count: 2 }], sizes: [{ id: 1, name: 'S' }, { id: 2, name: 'M' }, { id: 3, name: 'L' }, { id: 4, name: 'XL' }], priceBounds: { min: 0, max: 15000 } }; }
            function showToast(msg) { const el = byId('toast'); el.textContent = msg; el.classList.add('open'); clearTimeout(showToast.timer); showToast.timer = setTimeout(() => el.classList.remove('open'), 2500) }
            function setBusy() { byId('productGrid').setAttribute('aria-busy', 'true'); byId('productGrid').innerHTML = Array.from({ length: 9 }, () => `<div class="skeleton"><div class="product-picture"></div><div class="skeleton-line"></div><div class="skeleton-line short"></div></div>`).join(''); byId('topCount').textContent = 'Finding jerseys...'; byId('catalogBottom').hidden = true; }
            let currentAbort;
            async function loadProducts() {
                const seq = ++state.seq; if (currentAbort) currentAbort.abort(); currentAbort = new AbortController(); setBusy(); state.busy = true; try {
                    let data; if (state.preview) { data = previewResponse() } else { let params = new URLSearchParams({ page: String(state.page), pageSize: String(SETTINGS.pageSize), sort: state.sort }); if (state.search) params.set('search', state.search); if (state.collection) params.set('collection', state.collection); if (state.categoryId) params.set('categoryId', state.categoryId); if (state.sizeId) params.set('sizeId', state.sizeId); if (state.minPrice !== null) params.set('minPrice', state.minPrice); if (state.maxPrice !== null) params.set('maxPrice', state.maxPrice); if (state.inStock) params.set('inStock', 'true'); const result = await fetch(`${SETTINGS.api}?${params}`, { headers: { Accept: 'application/json' }, credentials: 'same-origin', signal: currentAbort.signal }); if (!result.ok) throw new Error(`Catalog API returned HTTP ${result.status}`); data = await result.json(); } if (seq !== state.seq) return; state.items = (data.products || data.Products || []).map(normalize); state.total = Number(data.total ?? data.Total ?? 0); state.page = Number(data.page ?? data.Page ?? state.page); state.totalPages = Math.max(1, Number(data.totalPages ?? data.TotalPages ?? 1)); state.categories = (data.categories || data.Categories || []).map(x => ({ id: Number(x.id ?? x.Id), name: String(x.name ?? x.Name), count: Number(x.count ?? x.Count ?? 0) }));
                    // Collection links map to actual Admin > Collections records through the shop API.
                    state.sizes = (data.sizes || data.Sizes || []).map(x => ({ id: Number(x.id ?? x.Id), name: String(x.name ?? x.Name) })); const b = data.priceBounds || data.PriceBounds; if (b) { state.bounds = { min: Math.max(0, Math.floor(Number(b.min ?? b.Min ?? 0))), max: Math.max(1, Math.ceil(Number(b.max ?? b.Max ?? 30000))) }; state.bounds.max = Math.max(state.bounds.min + 1, state.bounds.max) } renderFilters(); renderProducts(); syncUrl(); syncActiveNav();
                } catch (err) { if (err.name === 'AbortError') return; if (seq !== state.seq) return; byId('productGrid').setAttribute('aria-busy', 'false'); byId('topCount').textContent = 'Catalog unavailable'; byId('productGrid').innerHTML = `<div class="notice">${icon('refresh')}<h3>We couldn't load the shop.</h3><p>Check that the ASP.NET Core shop API is running. This page never substitutes sample merchandise for real database products.</p><button type="button" class="outline-btn" id="retryButton">Try again</button></div>`; byId('retryButton').addEventListener('click', loadProducts); console.warn('PANENKA Shop:', err); } finally { if (seq === state.seq) state.busy = false; }
            }
            function updateFilter(cb) { cb(); state.page = 1; loadProducts(); }
            function filterHtml() { const ct = state.categories.map(c => `<label class="radio-row"><span class="choice"><input type="radio" name="category" value="${c.id}" ${state.categoryId === c.id ? 'checked' : ''}><span>${esc(c.name)}</span></span><span class="count">${c.count || ''}</span></label>`).join(''); const sz = state.sizes.map(s => `<button class="size-btn ${state.sizeId === s.id ? 'active' : ''}" type="button" data-size="${s.id}" aria-pressed="${state.sizeId === s.id}" title="Size ${esc(s.name)}">${esc(s.name)}</button>`).join(''); const start = state.bounds.min, end = state.bounds.max, low = Math.min(end, state.minPrice ?? start), high = Math.max(low, state.maxPrice ?? end); const pos = x => 100 * (x - start) / (end - start); return `<section class="filter-section"><button class="filter-label" type="button" data-collapse aria-expanded="true">CATEGORY ${icon('down')}</button><div class="filter-content"><div class="radio-list"><label class="radio-row"><span class="choice"><input type="radio" name="category" value="" ${state.categoryId === null ? 'checked' : ''}><span>All collections</span></span></label>${ct || '<p class="filter-note">No categories yet.</p>'}</div></div></section><section class="filter-section"><button class="filter-label" type="button" data-collapse aria-expanded="true">PRICE RANGE ${icon('down')}</button><div class="filter-content"><div class="price-display"><span data-min-label>${cash(low)}</span><span data-max-label>${cash(high)}</span></div><div class="range-wrap" style="--lo:${pos(low)}%;--hi:${pos(high)}%"><div class="range-track"></div><div class="range-active"></div><input aria-label="Minimum price" data-range="min" type="range" min="${start}" max="${end}" step="1" value="${low}"><input aria-label="Maximum price" data-range="max" type="range" min="${start}" max="${end}" step="1" value="${high}"></div><div class="price-ends"><span>${cash(start)}</span><span>${cash(end)}</span></div></div></section><section class="filter-section"><button class="filter-label" type="button" data-collapse aria-expanded="true">SIZE ${icon('down')}</button><div class="filter-content"><div class="size-grid">${sz || '<span class="filter-note">No sizes yet.</span>'}</div><p class="filter-note">Sizes available across active jersey variants.</p></div></section><section class="filter-section"><button class="filter-label" type="button" data-collapse aria-expanded="true">AVAILABILITY ${icon('down')}</button><div class="filter-content"><label class="stock-label"><input type="checkbox" data-stock ${state.inStock ? 'checked' : ''}> In stock only</label></div></section>`; }
            function renderFilters() { const html = filterHtml(); byId('desktopFilterContents').innerHTML = html; byId('mobileFilterContents').innerHTML = html; renderChips(); }
            function renderChips() { const chips = []; const cat = state.categories.find(c => c.id === state.categoryId); if (cat) chips.push(['category', cat.name]); const size = state.sizes.find(s => s.id === state.sizeId); if (size) chips.push(['size', 'Size ' + size.name]); if (state.minPrice !== null || state.maxPrice !== null) chips.push(['price', cash(state.minPrice ?? state.bounds.min) + ' — ' + cash(state.maxPrice ?? state.bounds.max)]); if (state.inStock) chips.push(['stock', 'In stock']); if (state.search) chips.push(['search', 'Search: ' + state.search]); const el = byId('chips'); el.hidden = chips.length === 0; el.innerHTML = chips.map(([kind, label]) => `<button class="filter-chip" type="button" data-remove="${kind}">${esc(label)} ${icon('close')}</button>`).join(''); byId('filterNumber').hidden = chips.length === 0; byId('filterNumber').textContent = `(${chips.length})`; }
            function photoMarkup(p) { return p.imageUrl ? `<img src="${esc(p.imageUrl)}" alt="${esc(p.name)}" loading="lazy">` : `<div class="picture-placeholder"><span>PANENKA</span></div>`; }
            function cardHtml(p) { const saved = state.likes.has(String(p.id)); return `<article class="product-card"><button class="product-picture" type="button" data-open="${esc(p.id)}" aria-label="View ${esc(p.name)}">${photoMarkup(p)}${p.stockQuantity <= 0 ? '<span class="picture-badge sold">SOLD OUT</span>' : p.isNewArrival ? '<span class="picture-badge">NEW</span>' : ''}</button><button class="wish-btn" type="button" data-wish="${esc(p.id)}" aria-pressed="${saved}" aria-label="${saved ? 'Remove from' : 'Add to'} saved jerseys">${icon('heart')}</button><div class="card-meta"><div class="card-kind">${esc(p.category)}</div><button class="product-name" data-open="${esc(p.id)}" type="button">${esc(p.name)}</button><div class="price-line"><span class="price-now">${cash(p.price)}</span>${p.compareAtPrice > p.price ? `<span class="price-old">${cash(p.compareAtPrice)}</span>` : ''}</div><div class="availability ${p.stockQuantity <= 0 ? 'out' : ''}">${p.stockQuantity <= 0 ? 'Out of stock' : `${p.stockQuantity} available`}</div></div></article>`; }
            function renderProducts() { byId('productGrid').setAttribute('aria-busy', 'false'); const selected = state.categories.find(c => c.id === state.categoryId); byId('catalogTitle').textContent = selected?.name || (state.collection ? state.collection.replace(/[-_]/g,' ').replace(/\b\w/g,c=>c.toUpperCase()) : 'All Jerseys'); const start = state.total ? ((state.page - 1) * SETTINGS.pageSize + 1) : 0; const end = Math.min(state.total, state.page * SETTINGS.pageSize); byId('topCount').textContent = `${state.total} ${state.total === 1 ? 'jersey' : 'jerseys'}` + (state.preview ? ' · PREVIEW MODE' : ''); byId('bottomCount').textContent = `Showing ${start}–${end} of ${state.total} products`; byId('catalogBottom').hidden = state.total === 0; byId('productGrid').innerHTML = state.items.length ? state.items.map(cardHtml).join('') : `<div class="notice">${icon('search')}<h3>No jerseys found.</h3><p>Try clearing a filter or search for another club, edition or size.</p><button type="button" class="outline-btn" id="clearFromEmpty">Clear all filters</button></div>`; const clear = byId('clearFromEmpty'); if (clear) clear.addEventListener('click', clearAll); renderPages(); renderChips(); }
            function renderPages() { const el = byId('pagination'), max = state.totalPages; if (max <= 1) { el.innerHTML = ''; return; } const btn = (label, n, disabled = false, active = false) => `<button type="button" class="page-btn ${active ? 'active' : ''}" data-page="${n}" ${disabled ? 'disabled' : ''} ${active ? 'aria-current="page"' : ''} aria-label="Page ${n}">${label}</button>`; const pages = new Set([1, max, state.page - 1, state.page, state.page + 1].filter(n => n >= 1 && n <= max)); const ordered = [...pages].sort((a, b) => a - b); let parts = [btn('‹', state.page - 1, state.page <= 1)]; let old = 0; for (let n of ordered) { if (n - old > 1) parts.push('<span class="page-dots">…</span>'); parts.push(btn(n, n, false, n === state.page)); old = n; } parts.push(btn('›', state.page + 1, state.page >= max)); el.innerHTML = parts.join(''); }
            function clearAll() { setActiveNav('shop'); state.search = ''; state.collection = null; state.pendingCollection = null; state.categoryId = null; state.sizeId = null; state.minPrice = null; state.maxPrice = null; state.inStock = false; state.page = 1; byId('shopSearch').value = ''; closeDrawer(); loadProducts(); }
            function syncUrl() { const url = new URL(location.href); for (let k of ['search', 'categoryId', 'sizeId', 'minPrice', 'maxPrice', 'inStock', 'sort', 'page', 'collection']) url.searchParams.delete(k); if (state.search) url.searchParams.set('search', state.search); if (state.collection) url.searchParams.set('collection', state.collection); if (state.categoryId) url.searchParams.set('categoryId', state.categoryId); if (state.sizeId) url.searchParams.set('sizeId', state.sizeId); if (state.minPrice !== null) url.searchParams.set('minPrice', state.minPrice); if (state.maxPrice !== null) url.searchParams.set('maxPrice', state.maxPrice); if (state.inStock) url.searchParams.set('inStock', 'true'); if (state.sort !== 'newest') url.searchParams.set('sort', state.sort); if (state.page > 1) url.searchParams.set('page', state.page); history.replaceState(null, '', url.pathname + url.search + url.hash); }
            function openDrawer() { byId('filterDrawer').classList.add('open'); byId('filterOverlay').classList.add('open'); byId('filterDrawer').setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; byId('closeFilters').focus() }
            function closeDrawer() { byId('filterDrawer').classList.remove('open'); byId('filterOverlay').classList.remove('open'); byId('filterDrawer').setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; }
            async function openQuick(id) {
                const p = state.items.find(x => x.id === String(id)); if (!p) return;
                state.activeProduct=p;byId('quickDetails').href='/Product/Details/'+encodeURIComponent(p.slug||p.id); byId('quickCategory').textContent=p.category;
                byId('quickTitle').textContent=p.name;
                byId('quickPrice').textContent=cash(p.price);
                byId('quickDescription').textContent=p.description||'Select the correct jersey size and color.';
                byId('quickImageWrap').innerHTML=photoMarkup(p);
                byId('quickSizes').innerHTML='Loading available sizes and colors…';
                byId('quickAction').textContent='LOADING VARIANTS…';byId('quickAction').disabled=true;
                byId('quickModal').classList.add('open');byId('quickModal').setAttribute('aria-hidden','false');document.body.style.overflow='hidden';
                try {
                    const result=await fetch(`/api/storefront/cart/variants/${encodeURIComponent(p.id)}`,{credentials:'same-origin',headers:{Accept:'application/json'}});
                    if(!result.ok)throw Error('Variants are unavailable.');
                    const variants=await result.json();
                    if(state.activeProduct!==p)return;
                    if(!variants.length){byId('quickSizes').textContent='Out of stock for all sizes.';byId('quickAction').textContent='OUT OF STOCK';return;}
                    byId('quickSizes').innerHTML=`<label for="chooseVariant">SELECT SIZE & COLOR</label><select id="chooseVariant" style="display:block;width:100%;padding:13px;margin:10px 0;background:#fff;border:1px solid #ccc;color:#111">${variants.map(v=>`<option value="${Number(v.id)}" data-price="${Number(v.price)}">${esc(v.size)} / ${esc(v.color)} — ${cash(v.price)} (${Number(v.stockQuantity)} available)</option>`).join('')}</select><label for="chooseQty">QUANTITY</label><input id="chooseQty" type="number" min="1" max="100" value="1" style="padding:12px;border:1px solid #ccc;width:100%;margin:8px 0"><div id="quickStatus" role="status" style="margin-top:10px"></div>`;
                    byId('chooseVariant').addEventListener('change',()=>{const chosen=byId('chooseVariant').selectedOptions[0];byId('quickPrice').textContent=cash(chosen.dataset.price);
                     const selected=variants.find(v=>Number(v.id)===Number(chosen.value));
                     if(selected?.imageUrl&&selected.imageUrl.startsWith('/'))byId('quickImageWrap').innerHTML=`<img src="${esc(selected.imageUrl)}" alt="${esc(p.name)}">`;
                     byId('chooseQty').max=Math.min(100,Number(selected?.stockQuantity||100));});
                    byId('quickAction').disabled=false;byId('quickAction').textContent='ADD TO BAG →';
                }catch(e){byId('quickSizes').textContent=e.message;byId('quickAction').textContent='UNAVAILABLE';}
            }
            function closeQuick() { byId('quickModal').classList.remove('open'); byId('quickModal').setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; }
            // Keep Home/Shop/Player Edition/Retro/About consistent with the Index navigation.
            let activeNavKey = 'shop';
            function collectionNavKey() {
                if (state.collection === 'player' || state.collection === 'retro')
                    return state.collection;
                const selectedCategory = state.categories.find(category => category.id === state.categoryId);
                const name = (selectedCategory?.name || '').toLowerCase();
                if (name.includes('player')) return 'player';
                if (name.includes('retro') || name.includes('archive') || name.includes('classic')) return 'retro';
                return 'shop';
            }
            function moveNavUnderline(link) {
                const underline = byId('navUnderline');
                if (!link || !underline) return;
                if (!link.offsetWidth) { underline.style.opacity = '0'; return; }
                underline.style.width = link.offsetWidth + 'px';
                underline.style.transform = `translate3d(${link.offsetLeft}px,0,0)`;
                underline.style.opacity = '1';
            }
            function setActiveNav(key) {
                activeNavKey = ['home', 'shop', 'player', 'retro', 'about'].includes(key) ? key : 'shop';
                const desktopNav = byId('desktopNav');
                const all = document.querySelectorAll('#desktopNav a[data-nav], #mobileNav a[data-nav]');
                all.forEach(link => {
                    const selected = link.dataset.nav === activeNavKey;
                    link.classList.toggle('is-active', selected);
                    if (selected) link.setAttribute('aria-current', 'page');
                    else link.removeAttribute('aria-current');
                });
                moveNavUnderline(desktopNav.querySelector(`a[data-nav="${activeNavKey}"]`));
            }
            function syncActiveNav() { setActiveNav(collectionNavKey()); }
            function initNav() {
                const nav = byId('desktopNav');
                const links = [...nav.querySelectorAll('a[data-nav]')];
                const initiallySelected = new URLSearchParams(location.search).get('collection');
                setActiveNav(initiallySelected === 'player' || initiallySelected === 'retro' ? initiallySelected : 'shop');
                links.forEach(link => {
                    link.addEventListener('mouseenter', () => moveNavUnderline(link));
                    link.addEventListener('focus', () => moveNavUnderline(link));
                    link.addEventListener('click', () => setActiveNav(link.dataset.nav));
                });
                byId('mobileNav').querySelectorAll('a[data-nav]').forEach(link => {
                    link.addEventListener('click', () => setActiveNav(link.dataset.nav));
                });
                function restoreActive() {
                    moveNavUnderline(nav.querySelector(`a[data-nav="${activeNavKey}"]`));
                }
                nav.addEventListener('mouseleave', restoreActive);
                nav.addEventListener('focusout', event => {
                    if (!nav.contains(event.relatedTarget)) restoreActive();
                });
                window.addEventListener('resize', restoreActive);
                window.addEventListener('pageshow', restoreActive);
                if (document.fonts?.ready) document.fonts.ready.then(restoreActive);
                requestAnimationFrame(restoreActive);
            }


            async function loadBagCount(){try{const r=await fetch('/api/storefront/cart/count',{credentials:'same-origin',headers:{Accept:'application/json'}});if(!r.ok||!r.headers.get('content-type')?.includes('json'))return;const data=await r.json();const el=byId('basketCount');el.hidden=!data.count;el.textContent=data.count>99?'99+':data.count;}catch{}}
            async function loadWishlist(){try{const r=await fetch('/api/storefront/cart/wishlist',{credentials:'same-origin',headers:{Accept:'application/json'}});if(!r.ok||!r.headers.get('content-type')?.includes('json'))return;const data=await r.json();state.likes=new Set(data.productIds.map(String));document.querySelectorAll('[data-wish]').forEach(b=>b.setAttribute('aria-pressed',String(state.likes.has(b.dataset.wish))));}catch{}}

            function init() {
                byId('year').textContent = new Date().getFullYear(); initNav(); const params = new URLSearchParams(location.search); state.preview = false; state.search = (params.get('search') || '').trim().slice(0, 120); state.categoryId = Number(params.get('categoryId')) || null; state.sizeId = Number(params.get('sizeId')) || null; state.minPrice = params.has('minPrice') ? Math.max(0, Number(params.get('minPrice'))) || 0 : null; state.maxPrice = params.has('maxPrice') ? Math.max(0, Number(params.get('maxPrice'))) || 0 : null; state.inStock = params.get('inStock') === 'true'; state.page = Math.max(1, Number(params.get('page')) || 1); state.sort = ['newest', 'featured', 'price_asc', 'price_desc', 'name'].includes(params.get('sort')) ? params.get('sort') : 'newest'; const collection = params.get('collection'); if (collection) { state.collection = collection.toLowerCase().slice(0, 120); state.pendingCollection = state.collection; } byId('shopSearch').value = state.search; byId('sortSelect').value = state.sort;
                let searchTimer; byId('shopSearch').addEventListener('input', e => { clearTimeout(searchTimer); searchTimer = setTimeout(() => updateFilter(() => { state.search = e.target.value.trim().slice(0, 120) }), 320) }); byId('sortSelect').addEventListener('change', e => updateFilter(() => { state.sort = e.target.value })); byId('searchShortcut').addEventListener('click', () => { byId('shopSearch').focus(); byId('shopSearch').scrollIntoView({ behavior: 'smooth', block: 'center' }) }); byId('openFilters').addEventListener('click', openDrawer); byId('closeFilters').addEventListener('click', closeDrawer); byId('filterOverlay').addEventListener('click', closeDrawer); byId('applyFilters').addEventListener('click', closeDrawer);
                for (const box of [byId('desktopFilterContents'), byId('mobileFilterContents')]) { box.addEventListener('click', e => { const collapse = e.target.closest('[data-collapse]'); if (collapse) { const section = collapse.closest('.filter-section'); section.classList.toggle('collapsed'); collapse.setAttribute('aria-expanded', String(!section.classList.contains('collapsed'))); return; } const size = e.target.closest('[data-size]'); if (size) updateFilter(() => { const id = Number(size.dataset.size); state.sizeId = state.sizeId === id ? null : id; }); }); box.addEventListener('change', e => { if (e.target.matches('input[name="category"]')) updateFilter(() => { state.categoryId = Number(e.target.value) || null }); if (e.target.matches('[data-stock]')) updateFilter(() => { state.inStock = e.target.checked }); if (e.target.matches('[data-range]')) { const section = e.target.closest('.filter-section'); const a = Number(section.querySelector('[data-range=min]').value), b = Number(section.querySelector('[data-range=max]').value); updateFilter(() => { state.minPrice = a <= state.bounds.min ? null : a; state.maxPrice = b >= state.bounds.max ? null : b }); } }); box.addEventListener('input', e => { if (!e.target.matches('[data-range]')) return; const wrap = e.target.closest('.range-wrap'); const inputs = wrap.querySelectorAll('input'); const lower = inputs[0], upper = inputs[1]; if (Number(lower.value) > Number(upper.value)) { if (e.target === lower) upper.value = lower.value; else lower.value = upper.value; } const lo = Number(lower.value), hi = Number(upper.value), start = Number(lower.min), end = Number(lower.max); wrap.style.setProperty('--lo', 100 * (lo - start) / (end - start) + '%'); wrap.style.setProperty('--hi', 100 * (hi - start) / (end - start) + '%'); const display = wrap.closest('.filter-content'); display.querySelector('[data-min-label]').textContent = cash(lo); display.querySelector('[data-max-label]').textContent = cash(hi); }); }
                document.querySelectorAll('[data-clear]').forEach(b => b.addEventListener('click', clearAll)); byId('chips').addEventListener('click', e => { const b = e.target.closest('[data-remove]'); if (!b) return; updateFilter(() => { switch (b.dataset.remove) { case 'category': state.categoryId = null; break; case 'size': state.sizeId = null; break; case 'price': state.minPrice = null; state.maxPrice = null; break; case 'stock': state.inStock = false; break; case 'search': state.search = ''; byId('shopSearch').value = ''; break; } }) }); byId('pagination').addEventListener('click', e => { const b = e.target.closest('[data-page]'); if (!b || b.disabled) return; state.page = Number(b.dataset.page); loadProducts(); byId('shop-products').scrollIntoView({ behavior: 'smooth', block: 'start' }) }); byId('productGrid').addEventListener('click', async e => { const wish = e.target.closest('[data-wish]'); if (wish) { const id=String(wish.dataset.wish), isSaved=state.likes.has(id);
                    wish.disabled=true;
                    try { const res=await fetch('/api/storefront/cart/wishlist'+(isSaved?'/'+encodeURIComponent(id):''),{method:isSaved?'DELETE':'POST',credentials:'same-origin',headers:{'Accept':'application/json','Content-Type':'application/json','RequestVerificationToken':document.querySelector('meta[name="request-verification-token"]').content},...(!isSaved?{body:JSON.stringify({productId:Number(id)})}:{})});
                    if(res.redirected||res.status===401||res.headers.get('content-type')?.includes('text/html')){location.href='/Account/Login?returnUrl='+encodeURIComponent(location.pathname+location.search);return;}
                    if(!res.ok)throw Error('Could not save wishlist.');
                    if(isSaved)state.likes.delete(id);else state.likes.add(id);
                    wish.setAttribute('aria-pressed',String(!isSaved));showToast(isSaved?'Removed from wishlist.':'Saved to your wishlist.');
                    }catch(e){showToast(e.message)}finally{wish.disabled=false}return; } const open = e.target.closest('[data-open]'); if (open) openQuick(open.dataset.open) }); byId('closeQuick').addEventListener('click', closeQuick); byId('quickModal').addEventListener('click', e => { if (e.target === byId('quickModal')) closeQuick() }); byId('quickAction').addEventListener('click', async () => {
                    const p=state.activeProduct,variant=byId('chooseVariant'),qty=byId('chooseQty');
                    if(!p||!variant||!qty)return;
                    const count=Number(qty.value);
                    if(!Number.isInteger(count)||count<1||count>100){showToast('Choose a quantity between 1 and 100.');return;}
                    const action=byId('quickAction');action.disabled=true;action.textContent='ADDING…';
                    try {
                        const res=await fetch('/api/storefront/cart/items',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','Accept':'application/json','RequestVerificationToken':document.querySelector('meta[name="request-verification-token"]').content},body:JSON.stringify({productId:Number(p.id),variantId:Number(variant.value),quantity:count})});
                        if(res.redirected||res.status===401||res.headers.get('content-type')?.includes('text/html')){location.href='/Account/Login?returnUrl='+encodeURIComponent(location.pathname+location.search);return;}
                        const body=await res.json();if(!res.ok)throw Error(body.message||'Could not add to bag.');
                        closeQuick();showToast('Added to your bag.');loadBagCount();
                    }catch(e){showToast(e.message)}finally{action.disabled=false;action.textContent='ADD TO BAG →'}
                }); document.addEventListener('keydown', e => { if (e.key === 'Escape') { closeDrawer(); closeQuick(); closeMenu() } });
                const mobile = byId('mobileNav'), toggle = byId('menuToggle'); function closeMenu() { mobile.classList.remove('open'); toggle.setAttribute('aria-expanded', 'false') } toggle.addEventListener('click', () => { const opened = mobile.classList.toggle('open'); toggle.setAttribute('aria-expanded', String(opened)) }); mobile.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
                // Size/category filter links from homepage: use ?categoryId=... for exact database categories.
                // ?collection=player/retro matches category names only when using live API's returned metadata.
                loadProducts(); loadWishlist(); loadBagCount();
                fetch('/api/storefront/shop/banner',{headers:{Accept:'application/json'}})
                    .then(r=>r.ok&&r.status!==204?r.json():null).then(b=>{
                       if(!b)return;
                       if(b.imageUrl&&safeImg(b.imageUrl))document.querySelector('.hero-image img').src=b.imageUrl;
                       if(b.title)document.querySelector('.hero-content h1').textContent=b.title;
                       if(b.subtitle)document.querySelector('.hero-content p').textContent=b.subtitle;
                    }).catch(()=>{});
            }
            init();
    </script>
</body>
</html>
