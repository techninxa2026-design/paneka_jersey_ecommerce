@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{ var panenkaCsrf = Antiforgery.GetAndStoreTokens(Context).RequestToken; }
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="request-verification-token" content="@panenkaCsrf">
    <meta name="theme-color" content="#0b0d0f">
    <meta name="description" content="Shop PANENKA's premium football jerseys. Explore player editions, classic shirts and club collections.">
    <title>Shop All Jerseys | PANENKA Football Culture</title>
    <link rel="icon" type="image/png" href="~/assets/brands/panekalogo.jpeg" />
    <link rel="shortcut icon" href="~/assets/brands/panekalogo.jpeg" />
    <link rel="apple-touch-icon" href="~/assets/brands/panekalogo.jpeg" />
    <meta name="theme-color" content="#111111" />
    <style>
            :root {
                --black: #0b0d0f;
                --ink: #121416;
                --white: #fff;
                --muted: #777b7e;
                --hair: #e7e7e7;
                --gutter: clamp(20px,5.15vw,82px);
                --max: 1550px;
                --ease: cubic-bezier(.19,.75,.2,1)
            }

            *, *:before, *:after {
                box-sizing: border-box
            }

            html {
                scroll-behavior: smooth;
                scroll-padding-top: 90px
            }

            body {
                margin: 0;
                font-family: Inter,"Helvetica Neue",Helvetica,Arial,sans-serif;
                color: var(--ink);
                background: #fff;
                -webkit-font-smoothing: antialiased
            }

            a {
                color: inherit;
                text-decoration: none
            }

            button, input, select {
                font: inherit
            }

            button {
                cursor: pointer
            }

            img {
                max-width: 100%;
                display: block
            }

            svg {
                width: 20px;
                height: 20px;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.7;
                stroke-linecap: round;
                stroke-linejoin: round;
                flex: none
            }

            [hidden] {
                display: none !important
            }

            button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible {
                outline: 2px solid #9aa0a4;
                outline-offset: 3px
            }

            .sr-only {
                position: absolute !important;
                width: 1px;
                height: 1px;
                overflow: hidden;
                clip: rect(0,0,0,0);
                white-space: nowrap
            }

            .container {
                width: min(100%,var(--max));
                margin-inline: auto;
                padding-inline: var(--gutter)
            }
            /* PANENKA navigation, shared visual language with the homepage */
            .site-header {
                height: 75px;
                background: #090c0f;
                color: #fff;
                position: relative;
                z-index: 55
            }

            .header-inner {
                height: 100%;
                display: grid;
                grid-template-columns: 1fr auto 1fr;
                align-items: center
            }

            .brand {
                font-weight: 850;
                letter-spacing: -.07em;
                font-size: 25px;
                line-height: 1
            }

            .main-nav {
                position: relative;
                display: flex;
                height: 100%;
                align-items: center;
                gap: 41px
            }

                .main-nav > a {
                    height: 100%;
                    display: flex;
                    align-items: center;
                    font-size: 12px;
                    font-weight: 600;
                    color: #cdd0d2;
                    transition: color .2s;
                    white-space: nowrap
                }

                    .main-nav > a:hover, .main-nav > a.is-active {
                        color: white
                    }

            .nav-underline {
                position: absolute;
                bottom: 0;
                left: 0;
                width: 0;
                height: 2px;
                background: #fff;
                opacity: 0;
                pointer-events: none;
                transition: transform .27s var(--ease),width .27s var(--ease),opacity .2s
            }

            .header-tools {
                justify-self: end;
                display: flex;
                align-items: center;
                gap: 19px
            }

            .icon-btn {
                width: 27px;
                height: 32px;
                border: 0;
                background: none;
                color: inherit;
                padding: 3px;
                display: grid;
                place-items: center;
                position: relative
            }

                .icon-btn:hover {
                    opacity: .73
                }

                .icon-btn svg {
                    width: 21px;
                    height: 21px
                }

            .basket-count {
                position: absolute;
                right: -8px;
                top: -3px;
                background: #fff;
                color: #111;
                border-radius: 20px;
                min-width: 15px;
                padding: 2px 3px;
                font-size: 9px;
                line-height: 1.2;
                font-weight: 800;
                text-align: center
            }

            .menu-toggle, .mobile-nav {
                display: none
            }

            .mobile-nav {
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                background: #0e1012;
                padding: 10px var(--gutter) 18px;
                border-top: 1px solid #292d30;
                box-shadow: 0 25px 35px #0005
            }

                .mobile-nav > a {
                    padding: 14px 0;
                    display: block;
                    font-size: 13px;
                    border-bottom: 1px solid #242729;
                    color: #d0d2d4
                }

                    .mobile-nav > a.is-active {
                        color: #fff;
                        border-bottom-color: #fff
                    }
            /* Editorial collection intro */
            .shop-hero {
                position: relative;
                isolation: isolate;
                overflow: hidden;
                background: #0d0f11;
                color: white;
                min-height: 298px
            }

            .hero-image {
                position: absolute;
                inset: 0 0 0 42%;
                z-index: -2;
                overflow: hidden
            }

                .hero-image img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    object-position: 50% 43%;
                    filter: grayscale(.72) contrast(1.03) brightness(.77)
                }

            .shop-hero:after {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(90deg,#0c0e10 5%,#0c0e10 31%,rgba(12,14,16,.91) 42%,rgba(12,14,16,.42) 69%,rgba(12,14,16,.13) 100%);
                pointer-events: none;
                z-index: -1
            }

            .hero-content {
                position: relative;
                min-height: 298px;
                padding-top: 45px;
                padding-bottom: 46px;
                display: flex;
                flex-direction: column;
                justify-content: center
            }

            .eyebrow {
                font-size: 10px;
                letter-spacing: .23em;
                text-transform: uppercase;
                font-weight: 800;
                color: #a9adb0
            }

            .hero-content h1 {
                font-size: clamp(52px,6.25vw,88px);
                line-height: .92;
                letter-spacing: -.077em;
                font-weight: 840;
                max-width: 750px;
                margin: 18px 0 14px
            }

                .hero-content h1 span {
                    display: block
                }

            .hero-content p {
                margin: 0;
                max-width: 400px;
                font-size: 13px;
                line-height: 1.7;
                color: #d0d1d2
            }

            .hero-stamp {
                position: absolute;
                right: var(--gutter);
                top: 50px;
                font-size: 10px;
                font-weight: 650;
                line-height: 1.7;
                letter-spacing: .075em;
                text-align: right;
                color: #e1e1e1
            }
            /* Collection directory */
            .crumb-bar {
                border-bottom: 1px solid var(--hair);
                background: #fff
            }

            .crumb-inner {
                min-height: 58px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
                font-size: 11px;
                color: #777b7e
            }

                .crumb-inner a {
                    color: #333
                }

                    .crumb-inner a:hover {
                        text-decoration: underline
                    }

            .crumb-sep {
                padding: 0 10px;
                color: #bbb
            }

            .collection-id {
                font-size: 10px;
                letter-spacing: .13em;
                font-weight: 750;
                color: #777
            }

            .shop-layout {
                display: grid;
                grid-template-columns: 245px minmax(0,1fr);
                gap: clamp(28px,4vw,67px);
                align-items: start;
                padding-top: 42px;
                padding-bottom: 85px
            }

            .filter-aside {
                align-self: start;
                position: sticky;
                top: 25px
            }

            .filter-top {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding-bottom: 22px;
                border-bottom: 1px solid #dedede
            }

                .filter-top h2 {
                    font-size: 15px;
                    font-weight: 790;
                    margin: 0;
                    letter-spacing: -.02em
                }

            .small-clear {
                background: none;
                border: 0;
                text-decoration: underline;
                text-underline-offset: 3px;
                font-size: 11px;
                color: #6e7173;
                padding: 0
            }

            .filter-section {
                border-bottom: 1px solid #e5e5e5;
                padding: 26px 0 28px
            }

            .filter-label {
                display: flex;
                align-items: center;
                justify-content: space-between;
                width: 100%;
                padding: 0;
                margin: 0 0 18px;
                background: none;
                border: 0;
                color: #111;
                text-align: left;
                font-size: 11px;
                font-weight: 840;
                letter-spacing: .135em;
                text-transform: uppercase
            }

                .filter-label .chevron {
                    width: 15px;
                    height: 15px;
                    transform: rotate(180deg);
                    color: #888;
                    transition: transform .2s
                }

            .filter-section.collapsed .chevron {
                transform: rotate(0)
            }

            .filter-section.collapsed .filter-content {
                display: none
            }

            .filter-content {
                display: block
            }

            .radio-list {
                display: grid;
                gap: 15px
            }

            .radio-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                font-size: 12px;
                color: #575a5e;
                cursor: pointer
            }

                .radio-row:hover {
                    color: #111
                }

                .radio-row .choice {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    min-width: 0
                }

                .radio-row input {
                    accent-color: #111;
                    width: 15px;
                    height: 15px;
                    margin: 0
                }

                .radio-row span.count {
                    font-size: 10px;
                    color: #a4a6a8
                }

                .radio-row:has(input:checked) {
                    font-weight: 750;
                    color: #111
                }

            .price-display {
                display: flex;
                justify-content: space-between;
                gap: 8px;
                font-size: 13px;
                font-weight: 750;
                margin: 4px 0 19px
            }

            .range-wrap {
                height: 25px;
                position: relative;
                --lo: 0%;
                --hi: 100%
            }

            .range-track {
                position: absolute;
                top: 11px;
                height: 2px;
                left: 0;
                right: 0;
                background: #dedede
            }

            .range-active {
                height: 2px;
                position: absolute;
                top: 11px;
                left: var(--lo);
                right: calc(100% - var(--hi));
                background: #111
            }

            .range-wrap input {
                position: absolute;
                left: 0;
                top: 0;
                appearance: none;
                -webkit-appearance: none;
                height: 25px;
                width: 100%;
                background: transparent;
                pointer-events: none;
                margin: 0
            }

                .range-wrap input::-webkit-slider-thumb {
                    -webkit-appearance: none;
                    pointer-events: auto;
                    background: #101214;
                    border: 3px solid #fff;
                    box-shadow: 0 0 0 1px #111;
                    width: 13px;
                    height: 13px;
                    border-radius: 50%;
                    cursor: grab
                }

                .range-wrap input::-moz-range-thumb {
                    pointer-events: auto;
                    background: #111;
                    border: 2px solid #fff;
                    box-shadow: 0 0 0 1px #111;
                    width: 11px;
                    height: 11px;
                    border-radius: 50%;
                    cursor: grab
                }

            .price-ends {
                display: flex;
                justify-content: space-between;
                margin-top: 9px;
                font-size: 10px;
                color: #8d9092
            }

            .size-grid {
                display: grid;
                grid-template-columns: repeat(4,1fr);
                gap: 8px
            }

            .size-btn {
                min-height: 38px;
                border: 1px solid #e0e0e0;
                background: #fff;
                color: #424548;
                font-size: 11px;
                font-weight: 670;
                transition: .18s;
                overflow: hidden;
                white-space: nowrap;
                text-overflow: ellipsis;
                padding: 0 3px
            }

                .size-btn:hover {
                    border-color: #111
                }

                .size-btn.active {
                    background: #111;
                    border-color: #111;
                    color: #fff
                }

            .stock-label {
                display: flex;
                align-items: center;
                gap: 11px;
                font-size: 12px;
                color: #525558;
                cursor: pointer
            }

                .stock-label input {
                    accent-color: #111;
                    width: 16px;
                    height: 16px;
                    margin: 0
                }

            .filter-note {
                margin: 12px 0 0;
                font-size: 10px;
                color: #989b9d;
                line-height: 1.5
            }

            .mobile-filter-btn {
                display: none
            }

            .catalog {
                min-width: 0
            }

            .catalog-upper {
                display: flex;
                justify-content: space-between;
                align-items: end;
                gap: 20px;
                padding-bottom: 22px
            }

            .catalog-heading .catalog-eyebrow {
                font-size: 10px;
                font-weight: 800;
                color: #8b8e91;
                letter-spacing: .16em
            }

            .catalog-heading h2 {
                font-size: clamp(28px,3vw,41px);
                line-height: 1.1;
                letter-spacing: -.058em;
                margin: 7px 0 0;
                font-weight: 800
            }

            .catalog-count {
                font-size: 11px;
                color: #96989b;
                white-space: nowrap;
                padding-bottom: 3px
            }

            .tools-row {
                display: grid;
                grid-template-columns: minmax(180px,1fr) auto;
                gap: 12px;
                align-items: center;
                margin-bottom: 23px
            }

            .search-wrap {
                display: flex;
                align-items: center;
                gap: 10px;
                border: 1px solid #e1e1e1;
                height: 46px;
                padding: 0 14px;
                background: #fff;
                transition: border-color .2s
            }

                .search-wrap:focus-within {
                    border-color: #222
                }

                .search-wrap svg {
                    width: 18px;
                    height: 18px;
                    color: #777
                }

                .search-wrap input {
                    width: 100%;
                    min-width: 0;
                    background: transparent;
                    border: 0;
                    outline: 0;
                    font-size: 12px;
                    color: #111
                }

                    .search-wrap input::placeholder {
                        color: #a1a4a6
                    }

            .sort-wrap {
                border: 1px solid #e1e1e1;
                height: 46px;
                display: flex;
                align-items: center;
                padding: 0 13px;
                gap: 7px;
                min-width: 185px
            }

                .sort-wrap label {
                    font-size: 10px;
                    color: #a0a2a3;
                    white-space: nowrap
                }

                .sort-wrap select {
                    font-size: 11px;
                    border: 0;
                    background: transparent;
                    color: #151718;
                    outline: 0;
                    min-width: 0;
                    width: 100%;
                    font-weight: 650;
                    cursor: pointer
                }

            .filter-chips {
                display: flex;
                gap: 7px;
                align-items: center;
                flex-wrap: wrap;
                margin: -5px 0 20px
            }

            .filter-chip {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                border: 1px solid #dadcdd;
                padding: 8px 10px;
                background: #fdfdfd;
                color: #555;
                font-size: 10px
            }

                .filter-chip svg {
                    width: 12px;
                    height: 12px
                }

                .filter-chip:hover {
                    border-color: #111
                }
            /* Editorial product cards */
            .product-grid {
                display: grid;
                grid-template-columns: repeat(3,minmax(0,1fr));
                gap: 32px 16px
            }

            .product-card {
                position: relative;
                min-width: 0
            }

            .product-picture {
                position: relative;
                display: block;
                background: #14171a;
                aspect-ratio: .98;
                overflow: hidden;
                cursor: pointer;
                border: 0;
                width: 100%;
                padding: 0;
                text-align: left
            }

                .product-picture img {
                    height: 100%;
                    width: 100%;
                    object-fit: cover;
                    transition: transform .55s var(--ease)
                }

                .product-picture:hover img {
                    transform: scale(1.065)
                }

            .picture-placeholder {
                position: absolute;
                inset: 0;
                display: grid;
                place-items: center;
                color: #919599;
                background: #151719
            }

                .picture-placeholder span {
                    font-size: 17px;
                    font-weight: 800;
                    letter-spacing: -.07em
                }

            .picture-badge {
                position: absolute;
                bottom: 12px;
                left: 12px;
                background: #fff;
                color: #111;
                font-size: 9px;
                letter-spacing: .08em;
                padding: 4px 7px;
                font-weight: 850
            }

                .picture-badge.sold {
                    background: #d9d9d9
                }

            .wish-btn {
                position: absolute;
                right: 11px;
                top: 11px;
                display: grid;
                place-items: center;
                border: 0;
                background: rgba(0,0,0,.37);
                width: 30px;
                height: 30px;
                color: #fff;
                z-index: 2
            }

                .wish-btn:hover {
                    background: #0009
                }

                .wish-btn svg {
                    width: 18px;
                    height: 18px
                }

                .wish-btn[aria-pressed=true] {
                    color: #ff9ab2
                }

                    .wish-btn[aria-pressed=true] svg {
                        fill: currentColor
                    }

            .card-meta {
                padding: 13px 1px 0
            }

            .card-kind {
                font-size: 9px;
                letter-spacing: .115em;
                text-transform: uppercase;
                color: #929597;
                font-weight: 700;
                margin-bottom: 8px
            }

            .product-name {
                display: block;
                border: 0;
                padding: 0;
                background: none;
                color: #17191b;
                font-size: 13px;
                line-height: 1.45;
                font-weight: 670;
                text-align: left;
                min-height: 38px;
                cursor: pointer
            }

                .product-name:hover {
                    text-decoration: underline;
                    text-underline-offset: 3px
                }

            .price-line {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-top: 9px;
                flex-wrap: wrap
            }

            .price-now {
                font-size: 13px;
                font-weight: 830;
                color: #101214
            }

            .price-old {
                font-size: 11px;
                color: #989b9d;
                text-decoration: line-through
            }

            .availability {
                font-size: 10px;
                margin-top: 8px;
                color: #8b8d8f
            }

                .availability:before {
                    content: "";
                    display: inline-block;
                    width: 5px;
                    height: 5px;
                    border-radius: 50%;
                    background: #578069;
                    vertical-align: middle;
                    margin: 0 6px 1px 0
                }

                .availability.out:before {
                    background: #b96565
                }

            .catalog-bottom {
                margin-top: 43px;
                padding-top: 24px;
                border-top: 1px solid #e8e8e8;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 14px
            }

            .bottom-count {
                font-size: 11px;
                color: #8e9194
            }

            .pagination {
                display: flex;
                gap: 6px;
                align-items: center
            }

            .page-btn {
                border: 1px solid #e1e1e1;
                background: #fff;
                color: #111;
                min-width: 35px;
                height: 35px;
                padding: 0 9px;
                font-size: 11px;
                font-weight: 680
            }

                .page-btn:hover:not(:disabled) {
                    border-color: #111
                }

                .page-btn.active {
                    background: #111;
                    color: white;
                    border-color: #111
                }

                .page-btn:disabled {
                    opacity: .35;
                    cursor: default
                }

            .page-dots {
                padding: 0 5px;
                color: #999
            }

            .notice {
                grid-column: 1/-1;
                border: 1px solid #e5e5e5;
                padding: 65px 23px;
                text-align: center;
                background: #fafafa;
                color: #555
            }

                .notice svg {
                    width: 32px;
                    height: 32px;
                    margin: auto;
                    color: #444
                }

                .notice h3 {
                    color: #171717;
                    margin: 17px 0 8px;
                    font-size: 20px;
                    letter-spacing: -.03em
                }

                .notice p {
                    font-size: 12px;
                    line-height: 1.65;
                    max-width: 380px;
                    margin: 0 auto 20px
                }

            .outline-btn {
                height: 40px;
                border: 1px solid #111;
                background: transparent;
                color: #111;
                padding: 0 17px;
                font-size: 11px;
                font-weight: 750
            }

                .outline-btn:hover {
                    background: #111;
                    color: #fff
                }

            .skeleton {
                pointer-events: none
            }

                .skeleton .product-picture {
                    background: linear-gradient(95deg,#17191c 15%,#2d3034 43%,#17191c 76%);
                    background-size: 200% 100%;
                    animation: shimmer 1.3s infinite
                }

            .skeleton-line {
                height: 11px;
                margin-top: 12px;
                width: 79%;
                background: #e9e9e9
            }

                .skeleton-line.short {
                    width: 52%
                }

            @@keyframes shimmer {
                to {
                    background-position-x: -200%
                }
            }
            /* Small brand assurance and footer */
            .assurance {
                border-top: 1px solid #e5e5e5;
                background: #f9f9f9
            }

            .assurance-inner {
                display: grid;
                grid-template-columns: repeat(3,1fr);
                gap: 16px;
                min-height: 83px;
                align-items: center
            }

            .assurance-item {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 11px
            }

                .assurance-item svg {
                    width: 27px;
                    height: 27px
                }

                .assurance-item strong {
                    display: block;
                    font-size: 11px
                }

                .assurance-item span {
                    font-size: 10px;
                    color: #727576
                }

            .footer {
                background: #090c0f;
                color: #fff
            }

            .footer-inner {
                min-height: 107px;
                display: grid;
                grid-template-columns: 1fr auto 1fr;
                gap: 25px;
                align-items: center
            }

            .footer-brand {
                font-size: 18px;
                font-weight: 830;
                letter-spacing: -.06em
            }

            .footer-copyright {
