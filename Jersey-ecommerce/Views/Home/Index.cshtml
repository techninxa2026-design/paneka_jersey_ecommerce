@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{ var customerToken = Antiforgery.GetAndStoreTokens(Context).RequestToken; }
@{
    ViewData["Title"] = "Home Page";
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="request-verification-token" content="@customerToken">
  <meta name="theme-color" content="#0a0d10">
  <meta name="description" content="PANENKA — premium football jerseys, player editions, retro classics, and the culture behind the game.">
  <title>PANENKA — Football, beyond the ordinary.</title>
    <link rel="icon" type="image/png" href="~/assets/brands/panekalogo.jpeg" />
    <link rel="shortcut icon" href="~/assets/brands/panekalogo.jpeg" />
    <link rel="apple-touch-icon" href="~/assets/brands/panekalogo.jpeg" />
    <meta name="theme-color" content="#111111" />
  <style>
    /* PANENKA STOREFRONT — single-file styles, no Bootstrap or admin styles needed */
    :root {--ink:#0a0c0f;--paper:#fff;--muted:#6c7075;--edge:#e8e9ea;--max:1600px;--gutter:clamp(22px,5.25vw,84px);--ease:cubic-bezier(.2,.7,.2,1)}
    *,*::before,*::after{box-sizing:border-box}
    html{scroll-behavior:smooth;scroll-padding-top:78px}
    body{margin:0;background:#fff;color:#0a0b0c;font-family:Inter,"Helvetica Neue",Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased}
    img{display:block;width:100%} a{color:inherit;text-decoration:none} button,input{font:inherit} button{cursor:pointer} button:disabled{cursor:default}
    svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
    :focus-visible{outline:2px solid #ce7f9b;outline-offset:3px} .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    .container{width:min(100%,var(--max));margin-inline:auto;padding-inline:var(--gutter)}
    .site-header{height:76px;background:#090c0f;color:#fff;position:relative;z-index:30}
    .header-inner{height:100%;display:grid;grid-template-columns:1fr auto 1fr;align-items:center}
    .wordmark{font-size:25px;letter-spacing:-.075em;font-weight:850;font-stretch:condensed;line-height:1;white-space:nowrap}
    .header-nav{height:100%;display:flex;align-items:center;gap:42px}
    .header-nav a{height:100%;display:grid;place-items:center;position:relative;color:#e3e4e5;font-size:13px;font-weight:580;transition:color .2s}
    .header-nav a:hover{color:#fff}.header-nav a.is-active:after{content:"";position:absolute;bottom:0;left:0;right:0;height:1px;background:#d8d8d8}
    .header-tools{display:flex;justify-content:end;align-items:center;gap:22px}.tool{border:0;background:transparent;color:#fff;padding:6px;display:grid;place-items:center;position:relative}.tool svg{width:22px;height:22px}.tool:hover{opacity:.7}
    .cart-count{position:absolute;top:-2px;right:-3px;width:16px;height:16px;border-radius:50%;background:#c27d92;font-size:10px;font-weight:700;display:grid;place-items:center}.cart-count[hidden]{display:none}
    .menu-toggle{display:none}.mobile-menu{display:none}
    /* Main cover */
    .hero{background:#090c0f;position:relative;min-height:clamp(515px,40vw,655px);color:#fff;overflow:hidden;isolation:isolate}
    .hero-backdrop{position:absolute;inset:0 0 0 28%;z-index:-3;overflow:hidden}
    .hero-backdrop img{width:100%;height:100%;object-fit:cover;object-position:50% 50%;filter:saturate(.75) contrast(1.04);transition:opacity .35s}
    .hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#090c0f 0%,#090c0f 12%,rgba(9,12,15,.94) 22%,rgba(9,12,15,.57) 36%,rgba(9,12,15,0) 62%,rgba(9,12,15,.2) 100%),linear-gradient(0deg,rgba(3,6,9,.17),transparent 47%);pointer-events:none;z-index:-1}
    .hero-layout{height:100%;min-height:inherit;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding-top:55px;padding-bottom:70px;position:relative}
    .hero-copy{max-width:615px}.hero-title{font-size:clamp(57px,6vw,96px);font-weight:800;letter-spacing:-.07em;line-height:.97;margin:0 0 26px}
    .hero-desc{max-width:337px;font-size:16px;line-height:1.58;color:#e6e7e8;margin:0 0 29px}
    .btn-white{display:inline-flex;align-items:center;justify-content:space-between;gap:34px;background:#fff;color:#111;min-width:238px;height:54px;padding:0 22px;font-size:12px;font-weight:800;letter-spacing:.015em;border:1px solid #fff;transition:transform .2s,background .2s}
    .btn-white:hover{transform:translateY(-2px);background:#e7e7e7}.btn-white svg{height:18px;width:18px}
    .hero-edition{position:absolute;right:var(--gutter);top:60px;color:rgba(255,255,255,.82);text-align:right;font-size:12px;line-height:1.65;letter-spacing:.045em;font-weight:500}
    .hero-pagination{position:absolute;bottom:32px;left:var(--gutter);display:flex;align-items:center;gap:20px;font-size:12px;font-weight:700;letter-spacing:.04em}
    .hero-lines{display:flex;gap:9px;align-items:center}.hero-line{border:0;width:47px;height:12px;position:relative;background:transparent;padding:0}.hero-line:before{content:"";display:block;width:100%;height:1px;background:rgba(255,255,255,.24)}.hero-line[aria-current="true"]:before{background:#fff;height:2px}
    /* Collection banners */
    .collections{padding-top:22px;padding-bottom:40px;background:#fff}
    .category-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
    .category-card{position:relative;height:clamp(205px,18.2vw,275px);overflow:hidden;color:#fff;background:#101317;isolation:isolate;display:block}
    .category-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .6s var(--ease);z-index:-2}
    .category-card::before{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.88),rgba(0,0,0,.28) 37%,rgba(0,0,0,.02) 78%);z-index:-1}
    .category-card:hover img{transform:scale(1.07)}.category-info{position:absolute;bottom:23px;left:22px;right:8px}.category-name{font-size:17px;line-height:1.15;font-weight:770;letter-spacing:.002em;text-transform:uppercase;margin-bottom:10px}.category-link{font-size:12px;color:#f0f0f0;font-weight:500;display:flex;align-items:center;gap:7px}.category-link svg{height:13px;width:13px}
    /* product cards */
    .arrivals{padding-top:8px;padding-bottom:58px;background:#fff}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:24px}.section-heading h2{font-size:29px;letter-spacing:-.04em;font-weight:790;margin:0;line-height:1.15}.section-heading .section-subtitle{font-size:12px;color:#76797c;margin-top:5px;display:block}
    .view-all{border:0;background:transparent;display:inline-flex;align-items:center;gap:9px;padding:5px 0;font-size:13px;font-weight:550;white-space:nowrap}.view-all:hover{text-decoration:underline;text-underline-offset:4px}.view-all svg{width:17px;height:17px}
    .product-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px}
    .product-card{min-width:0;position:relative;cursor:pointer}.product-cover{background:#141518;position:relative;aspect-ratio:1.14;overflow:hidden;isolation:isolate}
    .product-cover img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;transition:transform .55s var(--ease)}
    .product-card:hover .product-cover img{transform:scale(1.065)}.new-badge{position:absolute;left:12px;bottom:12px;background:#fff;color:#141414;font-weight:800;font-size:10px;padding:3px 7px;letter-spacing:.06em}
    .favorite{position:absolute;top:12px;right:10px;border:0;background:rgba(10,12,15,.25);color:#fff;padding:5px;display:grid;place-items:center}.favorite svg{height:20px;width:20px;stroke-width:1.65}.favorite[aria-pressed="true"]{color:#fa7694}.favorite[aria-pressed="true"] svg{fill:currentColor}
    .product-title{font-size:14px;line-height:1.32;font-weight:570;margin:12px 0 3px;min-height:36px;letter-spacing:-.015em}.product-price{margin:10px 0 0;font-size:14px;font-weight:790;letter-spacing:.005em}.old-price{font-size:12px;color:#8a8d90;font-weight:450;margin-left:8px;text-decoration:line-through}.sold-out{color:#86888b;font-size:12px;font-weight:580;margin-top:6px}.product-cover:has(.sold-label):after{content:"";position:absolute;inset:0;background:rgba(0,0,0,.3)}.sold-label{position:absolute;left:12px;bottom:12px;background:#fff;color:#111;font-size:10px;font-weight:800;padding:4px 7px;z-index:1}
    .empty-state{grid-column:1/-1;padding:70px 10px;text-align:center;background:#f7f7f7;color:#65686a;font-size:14px}.empty-state strong{color:#111;display:block;margin-bottom:8px;font-size:20px}
    /* brand story */
    .story{display:grid;grid-template-columns:37.5% 62.5%;min-height:280px;background:#0b0d10;color:white;overflow:hidden}
    .story-copy{padding:44px var(--gutter) 39px max(var(--gutter),calc((100vw - var(--max))/2 + var(--gutter)));display:flex;flex-direction:column;align-items:flex-start;justify-content:center;min-width:0}
    .story-copy .wordmark{font-size:21px;margin-bottom:18px}.story h2{font-size:28px;letter-spacing:-.035em;line-height:1.18;font-weight:750;margin:0 0 12px}
    .story p{font-size:12.5px;line-height:1.58;color:#c6c8ca;max-width:305px;margin:0 0 20px}.story-link{display:inline-flex;align-items:center;gap:8px;color:white;font-size:12px;font-weight:600}.story-link svg{width:14px;height:14px}.story-photo{position:relative;min-height:275px;background:#222}.story-photo img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover;object-position:center}
    .benefits{background:#fff;border-bottom:1px solid #ededed}.benefits-inner{display:grid;grid-template-columns:repeat(3,1fr);min-height:72px;gap:18px;align-items:center}.benefit{display:flex;align-items:center;justify-content:center;gap:14px}.benefit svg{width:31px;height:31px;flex:none;color:#111}.benefit-text{display:flex;flex-direction:column;gap:2px;font-size:12px;font-weight:520;line-height:1.15}.benefit-text strong{font-size:11.5px;font-weight:740}
    .community{background:#f8f8f8;padding:20px 0 18px}.community-inner{display:grid;grid-template-columns:minmax(180px,280px) 1fr;align-items:center;gap:26px}.community h2{margin:0 0 4px;font-size:14px;font-weight:800;letter-spacing:-.015em}.community p{margin:0 0 15px;font-size:12px;color:#5b5f62}.btn-dark{display:inline-flex;align-items:center;justify-content:center;background:#090b0f;color:white;font-size:11px;padding:12px 17px;border:1px solid #090b0f;font-weight:750}.btn-dark:hover{background:#282b30}.community-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:11px}.community-photo{height:104px;background:#17191a;display:block;overflow:hidden}.community-photo img{width:100%;height:100%;object-fit:cover;transition:transform .3s}.community-photo:hover img{transform:scale(1.08)}
    .site-footer{background:#080c0f;color:#fff}.footer-inner{min-height:94px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:24px}.footer-brand .wordmark{font-size:18px}.copyright{margin-top:10px;color:#92969a;font-size:10px}.footer-nav{display:flex;gap:23px}.footer-nav a{font-size:11px;color:#d0d1d3}.footer-nav a:hover{text-decoration:underline}.footer-right{text-align:right;justify-self:end}.social-row{display:flex;gap:15px;justify-content:end;align-items:center}.social-row a{display:grid;place-items:center}.social-row svg{height:18px;width:18px}.footer-tagline{margin-top:13px;color:#a1a4a7;font-size:11px}
    /* overlays */
    .search-dialog{position:fixed;inset:0;background:rgba(0,0,0,.68);z-index:100;display:none;align-items:flex-start;justify-content:center;padding:115px 20px 20px}.search-dialog.open{display:flex}.search-panel{position:relative;width:min(620px,100%);padding:32px;background:#fff;box-shadow:0 30px 80px rgba(0,0,0,.24)}.search-panel h2{font-size:24px;letter-spacing:-.045em;margin:0 0 20px}.search-input-wrap{display:flex;align-items:center;gap:12px;border:1px solid #dedede;padding:12px 14px}.search-input-wrap svg{color:#5a5d60;flex:none}.search-input-wrap input{width:100%;border:0;outline:0;font-size:16px;background:transparent}.dialog-close{position:absolute;right:24px;top:24px;background:transparent;border:0;padding:0}.dialog-close svg{width:23px;height:23px}.search-hint{font-size:12px;color:#7c7d7e;margin:13px 0 0}
    .quick-modal{position:fixed;inset:0;background:rgba(0,0,0,.76);z-index:110;display:none;align-items:center;justify-content:center;padding:20px}.quick-modal.open{display:flex}.quick-panel{position:relative;display:grid;grid-template-columns:1fr 1fr;background:#fff;max-width:760px;width:100%;max-height:min(85vh,620px);overflow:auto}.quick-photo{background:#151719;min-height:340px}.quick-photo img{height:100%;object-fit:cover}.quick-details{padding:55px 35px}.quick-details .eyebrow{font-size:11px;letter-spacing:.1em;color:#777;text-transform:uppercase}.quick-details h2{font-size:31px;letter-spacing:-.04em;line-height:1.12;margin:13px 0}.quick-details p{color:#777;line-height:1.6;font-size:14px}.quick-details .quick-price{font-size:25px;color:#111;font-weight:780;margin:28px 0}.quick-panel .dialog-close{right:17px;top:17px;z-index:3;background:rgba(255,255,255,.8);padding:4px}.quick-shop{display:inline-flex;width:100%;align-items:center;justify-content:center;min-height:44px;background:#111;color:#fff;border:0;font-size:12px;text-transform:uppercase;font-weight:750}.quick-shop[hidden]{display:none}
    .toast{position:fixed;bottom:22px;right:22px;background:#111;color:#fff;padding:15px 22px;font-size:13px;z-index:150;max-width:330px;box-shadow:0 12px 35px #0003;transform:translateY(100px);opacity:0;transition:.25s;pointer-events:none}.toast.show{transform:translateY(0);opacity:1}
    @@media(max-width:1100px){.header-nav{gap:25px}.hero-title{font-size:clamp(56px,6.5vw,74px)}.product-grid{gap:12px}.category-info{left:15px}.category-name{font-size:15px}.story h2{font-size:25px}}
    @@media(max-width:720px){
      :root{--gutter:20px}
      html{scroll-padding-top:58px}.site-header{height:58px}.header-inner{grid-template-columns:1fr auto}.wordmark{font-size:21px}.header-nav{display:none}.header-tools{gap:13px}.tool{padding:3px}.tool svg{height:21px;width:21px}.menu-toggle{display:grid}.header-tools .account-icon{display:grid}
      .mobile-menu{display:none;position:absolute;top:58px;left:0;right:0;background:#0b0d10;border-top:1px solid #36393b;box-shadow:0 20px 35px #0004;padding:8px var(--gutter) 16px;z-index:40}.mobile-menu.open{display:block}.mobile-menu a{display:block;padding:14px 4px;color:#fff;font-size:14px;border-bottom:1px solid #272a2d}
      .hero{min-height:360px}.hero-backdrop{inset:0 0 0 5%}.hero-backdrop img{object-position:57% center}.hero:after{background:linear-gradient(90deg,#090c0f 0%,rgba(9,12,15,.89) 16%,rgba(9,12,15,.47) 50%,rgba(9,12,15,.18) 95%),linear-gradient(0deg,rgba(3,6,9,.35),transparent 50%)}
      .hero-layout{padding-top:42px;padding-bottom:48px}.hero-title{font-size:clamp(35px,8.35vw,59px);letter-spacing:-.065em;max-width:390px;margin-bottom:14px;line-height:1.02}.hero-desc{font-size:12.5px;line-height:1.53;max-width:230px;margin-bottom:18px}.btn-white{height:42px;min-width:172px;padding:0 13px;gap:18px;font-size:9.5px}.btn-white svg{width:15px;height:15px}.hero-edition{display:none}.hero-pagination{bottom:17px;font-size:10px;gap:13px}.hero-line{width:34px;height:9px}
      .collections{padding-top:14px;padding-bottom:29px}.category-grid{grid-template-columns:1fr;gap:11px}.category-card{height:125px}.category-card img{object-position:50% 46%}.category-card:before{background:linear-gradient(90deg,rgba(0,0,0,.75),rgba(0,0,0,.2) 63%,transparent),linear-gradient(0deg,rgba(0,0,0,.36),transparent)}.category-info{left:16px;bottom:14px}.category-name{font-size:16px;margin-bottom:5px}.category-link{font-size:11px}
      .arrivals{padding-top:0;padding-bottom:25px}.section-heading{margin-bottom:16px}.section-heading h2{font-size:21px}.section-heading .section-subtitle{font-size:10px}.view-all{font-size:11px;gap:5px}
      .product-grid{display:flex;flex-direction:column;gap:0}.product-card{display:grid;grid-template-columns:96px minmax(0,1fr);gap:14px;min-height:114px;align-items:center;padding:9px 0;border-bottom:1px solid #f0f0f0}.product-cover{aspect-ratio:1;width:96px}.new-badge{left:5px;bottom:5px;font-size:8px;padding:2px 5px}.favorite{right:3px;top:4px;padding:3px}.favorite svg{width:14px;height:14px}.product-meta{align-self:center}.product-title{font-size:12.5px;line-height:1.28;margin:0 0 9px;min-height:0;max-width:260px}.product-price{font-size:12px;margin:0}.old-price{font-size:10px}.empty-state{padding:55px 8px}
