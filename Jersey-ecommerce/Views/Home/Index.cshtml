    @@media(max-width:390px){:root{--gutter:16px}.header-tools{gap:10px}.hero{min-height:345px}.hero-title{font-size:35px}.hero-desc{max-width:200px}.story h2{font-size:17px}.story p{font-size:9px}.community-photo{height:57px}.footer-nav{gap:13px}}
    @@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}

    /* ================================================================
       PANENKA REFERENCE REFINEMENTS
       Desktop stays editorial white under the dark hero; mobile stays
       dark from header to footer, exactly like the supplied mock-up.
       The entire storefront remains self-contained in this HTML file.
       ================================================================ */
    .hero { min-height:clamp(540px,42vw,670px); }
    .hero-backdrop { inset:0 0 0 29%; }
    .hero-backdrop img { object-position:center center; }
    .product-cover { aspect-ratio:1.22; }
    .product-title { max-width:218px; line-height:1.37; }
    .product-meta { min-width:0; }
    .story-photo img { object-position:center; }
    .community-photo img { object-position:center; }
    .view-all svg { flex:none; }
    .view-all[hidden], [hidden] { display:none!important; }
    .toast { border:1px solid #3b3d40; }
    @@media (min-width:721px) and (max-width:1030px) {
      .product-grid {grid-template-columns:repeat(5,minmax(0,1fr));gap:11px;}
      .product-title {font-size:12px;}
      .category-name {font-size:14px;}
      .story {grid-template-columns:39% 61%;}
    }
    @@media (max-width:720px) {
      html,body {background:#090c0f;color:#fff;}
      .site-header {background:#090c0f;border-bottom:1px solid #24262a;}
      .header-inner {grid-template-columns:1fr auto;}
      .header-tools {gap:17px;}
      .header-tools a[title="Shopping bag"] {display:none;}
      .header-tools .menu-toggle {display:grid;}
      .mobile-menu {background:#0b0d0f;border-color:#34383a;}
      .hero {min-height:382px;}
      .hero-backdrop {inset:0 0 0 18%;}
      .hero-backdrop img {object-position:46% center;}
      .hero:after {background:linear-gradient(90deg,#090c0f 0%,rgba(9,12,15,.97) 12%,rgba(9,12,15,.84) 27%,rgba(9,12,15,.45) 53%,rgba(9,12,15,.08) 100%),linear-gradient(0deg,rgba(3,6,9,.40),transparent 52%);}
      .hero-layout {padding-top:38px;padding-bottom:54px;}
      .hero-title {font-size:clamp(35px,9.1vw,50px);max-width:245px;line-height:1.035;letter-spacing:-.063em;}
      .hero-desc {font-size:12px;max-width:235px;color:#e1e1e1;line-height:1.54;}
      .btn-white {box-shadow:none;}
      .collections {background:#090c0f;padding-top:13px;padding-bottom:26px;}
      .category-grid {gap:10px;}
      .category-card {height:125px;background:#101316;}
      .category-card::before {background:linear-gradient(90deg,rgba(0,0,0,.76),rgba(0,0,0,.12) 85%),linear-gradient(0deg,rgba(0,0,0,.42),transparent 70%);}
      .category-name {font-size:15px;font-weight:760;}
