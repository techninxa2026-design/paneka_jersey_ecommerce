  <script>
    'use strict';
    // For your ASP.NET Core backend: GET /api/storefront/home returns JSON
    // { "products": [{ "id", "name", "slug", "price", "imageUrl", "category", "isNewArrival", "stockQuantity", "url" }], "cartCount": 0 }
    // Category names should reflect Category.Name from your database.
    // If the endpoint cannot be reached, the page shows screenshot-inspired preview products.
    const CONFIG = Object.freeze({
      apiUrl: window.PANENKA_API_URL || window.PANEKA_API_URL || '/api/storefront/home',
      productLinkBase: '/Product/Details/',
      fallbackEnabled: false,
      previewImages: [] // Production-only catalog: avoid embedding unused demo images.
    });
    const PREVIEW = [
      { id: 1, name:'Real Madrid 2025/26 Player Edition', slug:'real-madrid-2025-26-player-edition', price:12500, imageUrl:CONFIG.previewImages[0], category:'Player Edition', isNewArrival:true, stockQuantity:20 },
      { id: 2, name:'Barcelona 2024/25 Home Jersey', slug:'barcelona-2024-25-home-jersey', price:9500, imageUrl:CONFIG.previewImages[1], category:'Retro Archive', isNewArrival:true, stockQuantity:13 },
      { id: 3, name:'Inter Milan 2024/25 Home Jersey', slug:'inter-milan-2024-25-home-jersey', price:9500, imageUrl:CONFIG.previewImages[2], category:'Club Collection', isNewArrival:true, stockQuantity:8 },
      { id: 4, name:'Germany 2024 Home Jersey', slug:'germany-2024-home-jersey', price:9000, imageUrl:CONFIG.previewImages[3], category:'National Teams', isNewArrival:true, stockQuantity:11 },
      { id: 5, name:'Liverpool 2024/25 Home Jersey', slug:'liverpool-2024-25-home-jersey', price:9000, imageUrl:CONFIG.previewImages[4], category:'Club Collection', isNewArrival:true, stockQuantity:6 }
    ];
    const $ = s => document.querySelector(s);
    const byId = id => document.getElementById(id);
    const safeText = input => String(input ?? '').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
    function safeImage(value, fallback) {if(typeof value !== 'string' || !value.trim()) return fallback;const s=value.trim();if(s.startsWith('data:image/webp;base64,')||s.startsWith('data:image/png;base64,')||s.startsWith('data:image/jpeg;base64,'))return s;try{const u=new URL(s,location.href);if(u.protocol==='https:' || u.protocol==='http:')return u.href;}catch{}return fallback;}
    function safePath(value) {if(typeof value !== 'string'||!value.startsWith('/')||value.startsWith('//')||value.includes('\\'))return '';return value;}

    // Links are configured by staff. Accept only local paths or HTTP(S) destinations.
    function safeDestination(value) {
      if(typeof value!=='string')return '';
      const url=value.trim();
      if(url.startsWith('/')&&!url.startsWith('//')&&!url.includes('\\'))return url;
      if(url.startsWith('#')&&!url.includes('\\'))return url;
      try{const parsed=new URL(url);if(parsed.protocol==='https:'||parsed.protocol==='http:')return parsed.href;}catch{}
      return '';
    }
    function renderCampaigns(banners) {
      document.querySelectorAll('[data-campaign-placement]').forEach(node=>node.remove());
      const slots={
        HomeTop:{target:document.querySelector('.hero'),where:'afterend'},
        Home:{target:byId('collections'),where:'afterend'},
        HomeMiddle:{target:byId('arrivals'),where:'afterend'},
        Footer:{target:document.querySelector('.site-footer'),where:'beforebegin'}
      };
      const lastBySlot={};
      for(const banner of banners){
        const placement=banner?.placement||'Home';
        const slot=slots[placement];
        const imgSrc=safeImage(banner?.imageUrl,'');
        if(!slot?.target||!imgSrc)continue;
        const section=document.createElement('section');section.className='pn-campaigns';section.dataset.campaignPlacement=placement;
        const wrap=document.createElement('div');wrap.className='container';
        const anchor=document.createElement('a');anchor.className='pn-campaign';
        anchor.href=safeDestination(banner.linkUrl||'/shop')||'/shop';
        const image=document.createElement('img');image.src=imgSrc;image.alt=String(banner.title||'PANENKA campaign');image.loading='lazy';
        const copy=document.createElement('span');copy.className='pn-campaign-copy';
        const title=document.createElement('strong');title.textContent=String(banner.title||'EXPLORE PANENKA');
        const subtitle=document.createElement('small');subtitle.textContent=String(banner.subtitle||'');
        const arrow=document.createElement('span');arrow.className='pn-campaign-arrow';arrow.textContent='EXPLORE ↗';
        copy.append(title,subtitle,arrow);anchor.append(image,copy);wrap.append(anchor);section.append(wrap);
        if(lastBySlot[placement])lastBySlot[placement].insertAdjacentElement('afterend',section);
        else slot.target.insertAdjacentElement(slot.where,section);
        lastBySlot[placement]=section;
      }
    }
    function amount(n){return '৳ '+Number(n||0).toLocaleString('en-BD',{maximumFractionDigits:0});}
    function asBool(v){return v===true||v===1||v==='true';}
    const read = (o,...keys) => {for(const k of keys)if(o && o[k]!==undefined && o[k]!==null)return o[k];return undefined;};
    const normalize = (p,index)=>{
      const im=read(p,'imageUrl','ImageUrl','primaryImageUrl','PrimaryImageUrl','heroImage','HeroImage') || (Array.isArray(p.images) ? p.images[0]?.imageUrl : null);
      const cat=read(p,'category','CategoryName','categoryName') || (typeof p.Category==='object'?p.Category?.Name:p.Category);
      const fallback='';
      return {
        id:read(p,'id','Id')??index,name:String(read(p,'name','Name','title','Title')||'Football Jersey'),
        slug:String(read(p,'slug','Slug')||''),price:Number(read(p,'price','Price','basePrice','BasePrice')||0),
        compareAtPrice:Number(read(p,'compareAtPrice','CompareAtPrice')||0), imageUrl:safeImage(im,fallback),
        category:String(cat||'Club Collection'),description:String(read(p,'description','Description','shortDescription','ShortDescription')||''),
        isNewArrival:asBool(read(p,'isNewArrival','IsNewArrival')??true),
        stockQuantity:Number(read(p,'stockQuantity','StockQuantity','availableQuantity','AvailableQuantity')??0),
        url:safePath(read(p,'url','Url','productUrl','ProductUrl')||'')
      };
    };
    const state={all:[],visible:[],filter:'all',search:'',showAll:false,preview:false,liked:new Set()};
    // Saved jerseys are fetched from the authenticated wishlist in SQL Server.
    function note(text){const el=byId('toast');el.textContent=text;el.classList.add('show');clearTimeout(note.timer);note.timer=setTimeout(()=>el.classList.remove('show'),2500);}
    function matchingCollection(p,collection){
      if(collection==='all')return true;
      const haystack=(p.name+' '+p.category).toLowerCase();
      const terms={player:['player','edition','authentic'],retro:['retro','archive','classic','vintage','barcelona'],club:['club','home','away','madrid','inter','liverpool'],national:['national','country','germany','france','argentina','brazil']};
      return (terms[collection]||[]).some(t=>haystack.includes(t));
    }
    function icon(name){return `<svg aria-hidden="true"><use href="#ic-${name}"></use></svg>`;}
    function renderProducts(){
      let visible=state.all.filter(p=>(!state.search || (p.name+' '+p.category).toLowerCase().includes(state.search)) && matchingCollection(p,state.filter));
      if(state.filter==='all' && !state.search){const arrivals=visible.filter(p=>p.isNewArrival);if(arrivals.length)visible=arrivals;}
      if(!state.showAll)visible=visible.slice(0,5);
      state.visible=visible;
      const headings={all:'New Arrivals',player:'Player Edition',retro:'Retro Archive',club:'Club Collection',national:'National Teams'};
      byId('arrivalsTitle').textContent=state.search ? 'Search Results' : headings[state.filter];
      byId('viewAll').innerHTML=state.showAll ? 'Show Less '+icon('arrow') : 'View All '+icon('arrow');
      byId('viewAll').hidden=state.search.length>0 || state.filter!=='all';
      const grid=byId('productGrid');
      if(!visible.length){grid.innerHTML='<div class="empty-state"><strong>No jerseys found.</strong>Try a different search or browse another collection.</div>';return;}
      grid.innerHTML=visible.map((p,i)=>{
        const key=String(p.id), liked=state.liked.has(key),sold=p.stockQuantity<=0;
        return `<article class="product-card" data-product="${safeText(key)}" tabindex="0" aria-label="View ${safeText(p.name)}">
            <div class="product-cover">${p.imageUrl?`<img src="${safeText(p.imageUrl)}" alt="${safeText(p.name)}" loading="lazy">`:'<span style="display:grid;place-items:center;height:100%;color:#fff;font-weight:900">PANENKA</span>'}
              ${sold?'<span class="sold-label">SOLD OUT</span>':p.isNewArrival?'<span class="new-badge">NEW</span>':''}
              <button type="button" class="favorite" data-like="${safeText(key)}" aria-label="${liked?'Remove from':'Save to'} favorites" aria-pressed="${liked}">${icon('heart')}</button>
            </div><div class="product-meta"><h3 class="product-title">${safeText(p.name)}</h3><p class="product-price">${amount(p.price)}${p.compareAtPrice>p.price?`<span class="old-price">${amount(p.compareAtPrice)}</span>`:''}</p></div>
          </article>`;
      }).join('');
    }
    function openProduct(id){const p=state.all.find(x=>String(x.id)===String(id));if(!p)return;byId('quickImage').src=p.imageUrl;byId('quickImage').alt=p.name;byId('quickCategory').textContent=p.category;byId('quickTitle').textContent=p.name;byId('quickDescription').textContent=p.description||'Premium football jersey from the PANENKA collection.';byId('quickPrice').textContent=amount(p.price);
      const btn=byId('quickShop');if(p.url){btn.href=p.url;btn.hidden=false;byId('quickNote').textContent='Select your size and color on the product details page.';}else{btn.hidden=true;byId('quickNote').textContent='Product details route is not connected yet. Supply a product URL in the storefront API response.';}
      byId('quickModal').classList.add('open');document.body.style.overflow='hidden';byId('closeQuick').focus();}
    function closeOverlays(){byId('searchDialog').classList.remove('open');byId('quickModal').classList.remove('open');document.body.style.overflow='';}
    // ----------------------------------------------------------------------
    // Header navigation: the underline moves with the active link or hover.
    // The same state is reflected in the mobile menu and updated on scroll.
    // ----------------------------------------------------------------------
    const desktopNav = document.querySelector('.header-nav');
    const underline = desktopNav.querySelector('.nav-underline');
    const desktopLinks = [...desktopNav.querySelectorAll('a[data-nav]')];
    const allNavLinks = [...document.querySelectorAll('.header-nav a[data-nav], .mobile-menu a[data-nav]')];
    const navNames = new Set(['home', 'shop', 'player', 'retro', 'about']);
    let activeNav = 'home';
    let navIsReady = false;
    let manualNavigationUntil = 0;
    let manualNavigationTimer;

    function underlineAt(key) {
      const link = desktopLinks.find(a => a.dataset.nav === key);
      if (!link || link.offsetWidth === 0) return;
      if (!navIsReady) underline.style.transition = 'none';
      underline.style.width = `${link.offsetWidth}px`;
      underline.style.transform = `translate3d(${link.offsetLeft}px,0,0)`;
      underline.style.opacity = '1';
      if (!navIsReady) {
        navIsReady = true;
        requestAnimationFrame(() => underline.style.removeProperty('transition'));
      }
    }

    function setActiveNavigation(key, userAction = false) {
      if (!navNames.has(key)) key = 'shop';
      activeNav = key;
      if (userAction) {
        manualNavigationUntil = Date.now() + 1400;
        clearTimeout(manualNavigationTimer);
        manualNavigationTimer = setTimeout(updateNavigationOnScroll, 1430);
      }
      for (const link of allNavLinks) {
        const chosen = link.dataset.nav === key;
        link.classList.toggle('is-active', chosen);
        if (chosen) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
      underlineAt(key);
    }

    function closeMenu() {
      byId('mobileMenu').classList.remove('open');
      byId('menuToggle').setAttribute('aria-expanded', 'false');
      byId('menuToggle').setAttribute('aria-label', 'Open navigation');
    }

    function setCollection(value) {
      state.filter = value;
      state.search = '';
      state.showAll = false;
      renderProducts();
      closeMenu();
      setActiveNavigation(value === 'player' || value === 'retro' ? value : 'shop', true);
      byId('arrivals').scrollIntoView({behavior: window.matchMedia('(prefers-reduced-motion:reduce)').matches ? 'auto' : 'smooth', block: 'start'});
    }

    // Hover previews the underline; leaving or blurring returns it to the selected link.
    desktopLinks.forEach(link => {
      link.addEventListener('mouseenter', () => underlineAt(link.dataset.nav));
      link.addEventListener('focus', () => underlineAt(link.dataset.nav));
    });
    desktopNav.addEventListener('mouseleave', () => underlineAt(activeNav));
    desktopNav.addEventListener('focusout', event => {
      if (!desktopNav.contains(event.relatedTarget)) underlineAt(activeNav);
    });

    // Home / About are normal anchors; collections and Shop have their own handlers.
    allNavLinks.forEach(link => {
      link.addEventListener('click', event => {
        setActiveNavigation(link.dataset.nav, true);
        closeMenu();
        // Use one scroll controller for regular section links, too. This avoids
        // the native smooth scroll/hashchange race that resets the active item.
        if (!link.hasAttribute('data-collection') && !link.hasAttribute('data-show-all')) {
          const targetId = link.getAttribute('href')?.slice(1);
          const target = targetId && byId(targetId);
          if (target) {
            event.preventDefault();
            const behavior = window.matchMedia('(prefers-reduced-motion:reduce)').matches ? 'instant' : 'smooth';
            // A sticky header scrollIntoView() can stop midway, so Home uses scrollTo(0).
            if (targetId === 'top') window.scrollTo({top: 0, behavior});
            else target.scrollIntoView({behavior, block: 'start'});
          }
        }
      });
    });

    // Wordmark and footer Home links must also return to the document start.
    document.querySelectorAll('a[href="#top"]:not([data-nav])').forEach(link => {
      link.addEventListener('click', event => {
        event.preventDefault();
        closeMenu();
        setActiveNavigation('home', true);
        window.scrollTo({top: 0, behavior: window.matchMedia('(prefers-reduced-motion:reduce)').matches ? 'instant' : 'smooth'});
      });
    });

    function navigationForScroll() {
      const headerHeight = byId('top').offsetHeight;
      const line = window.scrollY + headerHeight + Math.min(window.innerHeight * 0.23, 180);
      const absoluteTop = id => byId(id).getBoundingClientRect().top + window.scrollY;
      if (line >= absoluteTop('story')) return 'about';
      if (line >= absoluteTop('collections')) {
        return state.filter === 'player' || state.filter === 'retro' ? state.filter : 'shop';
      }
      return 'home';
    }

    let navScrollFrame = 0;
    function updateNavigationOnScroll() {
      if (navScrollFrame) return;
      navScrollFrame = requestAnimationFrame(() => {
        navScrollFrame = 0;
        if (Date.now() >= manualNavigationUntil) {
          const section = navigationForScroll();
          if (section !== activeNav) setActiveNavigation(section);
        }
      });
    }
    window.addEventListener('scroll', updateNavigationOnScroll, {passive: true});
    window.addEventListener('resize', () => {
      underlineAt(activeNav);
      updateNavigationOnScroll();
      if (window.innerWidth > 720) closeMenu();
    }, {passive: true});
    window.addEventListener('hashchange', () => {
      // Handle a hash change from outside the menu (e.g., Back/Forward),
      // without overriding an in-progress smooth-scroll navigation.
      if (Date.now() < manualNavigationUntil) return;
      requestAnimationFrame(updateNavigationOnScroll);
    });
    // Position it after layout/fonts settle; avoid an incorrect initial left offset.
    setActiveNavigation(navigationForScroll());
    if (document.fonts?.ready) document.fonts.ready.then(() => underlineAt(activeNav));
    window.addEventListener('load', () => {
      underlineAt(activeNav);
      updateNavigationOnScroll();
    });
    byId('productGrid').addEventListener('click',async e=>{
      const like=e.target.closest('[data-like]');
      if(like){e.stopPropagation();const id=like.dataset.like,liked=state.liked.has(id);
        try{const res=await fetch('/api/storefront/cart/wishlist'+(liked?'/'+encodeURIComponent(id):''),{
          method:liked?'DELETE':'POST',credentials:'same-origin',headers:{'Accept':'application/json',
          'Content-Type':'application/json','RequestVerificationToken':document.querySelector('meta[name="request-verification-token"]').content},
          ...(!liked?{body:JSON.stringify({productId:Number(id)})}:{})});
          if(res.redirected||res.status===401||res.headers.get('content-type')?.includes('text/html')){
            location.href='/Account/Login?returnUrl='+encodeURIComponent(location.pathname);return;
          }
          if(!res.ok)throw Error('Could not update your saved jerseys.');
          if(liked)state.liked.delete(id);else state.liked.add(id);
          renderProducts();note(liked?'Removed from wishlist.':'Saved to wishlist.');
        }catch(err){note(err.message);}return;
      }
      const card=e.target.closest('[data-product]');if(card)openProduct(card.dataset.product);
    });
    byId('productGrid').addEventListener('keydown',e=>{if((e.key==='Enter'||e.key===' ')&&e.target.matches('.product-card')){e.preventDefault();openProduct(e.target.dataset.product);}});
    document.querySelectorAll('[data-collection]').forEach(a=>a.addEventListener('click',e=>{if(!a.dataset.collection)return;e.preventDefault();setCollection(a.dataset.collection);}));
    document.querySelectorAll('[data-show-all]').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();state.filter='all';state.search='';state.showAll=true;renderProducts();closeMenu();setActiveNavigation('shop',true);byId('arrivals').scrollIntoView({behavior:'smooth',block:'start'});}));
    byId('viewAll').addEventListener('click',()=>{state.showAll=!state.showAll;renderProducts();});
    byId('menuToggle').addEventListener('click',()=>{const v=byId('mobileMenu').classList.toggle('open');byId('menuToggle').setAttribute('aria-expanded',String(v));byId('menuToggle').setAttribute('aria-label',v?'Close navigation':'Open navigation');});
    byId('mobileMenu').querySelectorAll('a').forEach(a=>a.addEventListener('click',closeMenu));
    byId('searchToggle').addEventListener('click',()=>{closeOverlays();byId('searchDialog').classList.add('open');document.body.style.overflow='hidden';byId('searchInput').focus();});
    byId('closeSearch').addEventListener('click',closeOverlays);byId('closeQuick').addEventListener('click',closeOverlays);
    [byId('searchDialog'),byId('quickModal')].forEach(el=>el.addEventListener('click',e=>{if(e.target===el)closeOverlays();}));
    document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeOverlays();closeMenu();}});
    byId('searchInput').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();location.href='/shop?search='+encodeURIComponent(e.target.value.trim());}});
    // Slider keeps original first slide exactly aligned with the supplied design.
    const slides=[
      {title:'Football,<br>beyond the<br>ordinary.',desc:'Premium football jerseys. Player editions, retro classics and more — for those who live the game, not just watch it.',cta:'SHOP PLAYER EDITION',filter:'player',edition:'REAL MADRID<br>2025/26<br>PLAYER EDITION',image:'data:image/webp;base64,'},
      {title:'Icons never<br>leave the<br>game.',desc:'A collection of classics that made generations fall in love with football.',cta:'EXPLORE RETRO',filter:'retro',edition:'RETRO<br>ARCHIVE<br>COLLECTION',image:'data:image/webp;base64,'},
      {title:'Wear your<br>colors with<br>pride.',desc:'Club colors. Match-day moments. Stories worn close to your heart.',cta:'SHOP CLUB KITS',filter:'club',edition:'CLUB<br>COLLECTION<br>PANENKA',image:'data:image/webp;base64,'}
    ];
    let slideIndex=0;function showSlide(i){slideIndex=(i+slides.length)%slides.length;const s=slides[slideIndex];byId('heroTitle').innerHTML=s.title;byId('heroDesc').textContent=s.desc;byId('heroCTA').querySelector('span').textContent=s.cta;if(s.url){byId('heroCTA').href=s.url;byId('heroCTA').removeAttribute('data-collection');}
      else{byId('heroCTA').href='/shop?collection='+encodeURIComponent(s.filter||'player');byId('heroCTA').removeAttribute('data-collection');}byId('heroEdition').innerHTML=s.edition;byId('heroPhoto').src=(window.matchMedia('(max-width:720px)').matches&&s.mobileImage?s.mobileImage:s.image);byId('slideNumber').textContent=String(slideIndex+1).padStart(2,'0')+' / '+String(slides.length).padStart(2,'0');document.querySelectorAll('.hero-line').forEach((b,j)=>b.setAttribute('aria-current',String(i===j)));}
    document.querySelectorAll('[data-slide]').forEach(b=>b.addEventListener('click',()=>showSlide(Number(b.dataset.slide))));
    window.addEventListener('resize',()=>{const active=slides[slideIndex];byId('heroPhoto').src=(window.matchMedia('(max-width:720px)').matches&&active.mobileImage?active.mobileImage:active.image);});
    // No autoplay on small screens or reduced-motion mode: hero stays readable.
    if(!window.matchMedia('(prefers-reduced-motion:reduce)').matches&&!window.matchMedia('(max-width:720px)').matches){let clock=setInterval(()=>showSlide(slideIndex+1),8500);document.querySelector('.hero').addEventListener('mouseenter',()=>clearInterval(clock),{once:true});}
    async function loadStorefront(){
      try{
        const timeout=new AbortController();const timer=setTimeout(()=>timeout.abort(),9000);
        let result;try{result=await fetch(CONFIG.apiUrl,{headers:{'Accept':'application/json'},credentials:'same-origin',signal:timeout.signal});}finally{clearTimeout(timer);}
        if(!result.ok)throw new Error('HTTP '+result.status);
        const data=await result.json();const items=Array.isArray(data)?data:read(data,'products','Products','items','Items');
        if(!Array.isArray(items))throw new Error('Missing products array in API response');
        state.all=items.map((p,i)=>normalize(p,i));state.preview=false;
        if(Array.isArray(data.slides)&&data.slides.length){
          const live=data.slides.filter(x=>x.imageUrl||x.mobileImageUrl).map(x=>({
            title:safeText(x.title||'PANENKA').replace(/\n/g,'<br>'),
            desc:String(x.subtitle||''),cta:String(x.buttonText||'SHOP NOW'),
            url:safeDestination(x.buttonUrl||'/shop')||'/shop',
            filter:null,edition:'PANENKA<br>FOOTBALL CULTURE',image:safeImage(x.imageUrl||x.mobileImageUrl,''),mobileImage:safeImage(x.mobileImageUrl||x.imageUrl,'')
          }));
          if(live.length){slides.splice(0,slides.length,...live);showSlide(0);
            const pg=document.querySelector('.hero-lines');
            pg.innerHTML=slides.map((_,i)=>`<button type="button" class="hero-line" data-slide="${i}" aria-current="${i===0}" aria-label="Slide ${i+1}"></button>`).join('');
            pg.querySelectorAll('[data-slide]').forEach(b=>b.addEventListener('click',()=>showSlide(Number(b.dataset.slide))));
          }
        }
        const collectionCards=[...document.querySelectorAll('.category-card')];
        if(Array.isArray(data.collections)&&data.collections.length){
          data.collections.slice(0,collectionCards.length).forEach((c,i)=>{
            const card=collectionCards[i];card.removeAttribute('data-collection');
            card.href='/shop?collection='+encodeURIComponent(c.slug||c.name);
            const img=card.querySelector('img');if(c.imageUrl&&safeImage(c.imageUrl,''))img.src=c.imageUrl;
            const label=card.querySelector('.category-name');if(label)label.textContent=c.name;
          });
        }
        if(Array.isArray(data.banners))renderCampaigns(data.banners);
        if(data.settings){
          const social={'Instagram':'social.instagram','YouTube':'social.youtube','TikTok':'social.tiktok','Facebook':'social.facebook'};
          document.querySelectorAll('.social-row a[aria-label]').forEach(a=>{
            const value=data.settings[social[a.getAttribute('aria-label')]];
            if(typeof value==='string'&&/^https:\/\/[^\s]+$/i.test(value))a.href=value;
          });
          if(data.settings['seo.title'])document.title=data.settings['seo.title'];
          if(data.settings['seo.description']){
            const meta=document.querySelector('meta[name="description"]');if(meta)meta.content=data.settings['seo.description'];
          }
        }
        try{const wishlist=await fetch('/api/storefront/cart/wishlist',{credentials:'same-origin',headers:{Accept:'application/json'}});
          if(wishlist.ok&&wishlist.headers.get('content-type')?.includes('json')){
            const saved=await wishlist.json();state.liked=new Set((saved.productIds||[]).map(String));}}
          catch{};
        try{const bag=await fetch('/api/storefront/cart/count',{credentials:'same-origin',headers:{Accept:'application/json'}});
          if(bag.ok&&bag.headers.get('content-type')?.includes('json')){
            const dto=await bag.json();const count=Number(dto.count||0);byId('cartCount').hidden=count<=0;byId('cartCount').textContent=String(count);}}
          catch{};

        const count=Number(read(data,'cartCount','CartCount')||0);if(count>0){byId('cartCount').textContent=String(count);byId('cartCount').hidden=false;}
        byId('catalogStatus').hidden=true;
      }catch(err){
        console.warn('PANENKA storefront API unavailable.',err);
        state.preview=false;state.all=[];
        byId('catalogStatus').textContent='Unable to connect to the store catalog. Please refresh.';
        byId('catalogStatus').hidden=false;
      }
      renderProducts();
    }
    const newsletterForm=byId('newsletterForm');
    if(newsletterForm)newsletterForm.addEventListener('submit',async e=>{
      e.preventDefault();const button=newsletterForm.querySelector('button'),result=byId('newsletterStatus');button.disabled=true;
      try{const response=await fetch('/api/storefront/newsletter',{method:'POST',credentials:'same-origin',
        headers:{'Content-Type':'application/json','RequestVerificationToken':document.querySelector('meta[name="request-verification-token"]').content},
        body:JSON.stringify({email:byId('newsletterEmail').value.trim()})});
        const body=await response.json().catch(()=>({}));if(!response.ok)throw Error(body.message||'Could not subscribe.');
        result.textContent=body.message||'Subscribed successfully.';newsletterForm.reset();
      }catch(err){result.textContent=err.message;}finally{button.disabled=false}
    });
    byId('footerYear').textContent=String(new Date().getFullYear());
    loadStorefront();
  </script>
</body>
</html>
