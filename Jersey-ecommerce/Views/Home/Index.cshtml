      .footer-inner{min-height:110px;display:grid;grid-template-columns:1fr auto;grid-template-areas:"brand socials" "nav nav";row-gap:12px;padding-block:20px}.footer-brand{grid-area:brand}.footer-brand .wordmark{font-size:15px}.copyright{font-size:9px}.footer-nav{grid-area:nav;gap:18px;flex-wrap:wrap}.footer-nav a{font-size:10px}.footer-right{grid-area:socials}.footer-tagline{font-size:9px;margin-top:11px}.social-row svg{width:15px;height:15px}
