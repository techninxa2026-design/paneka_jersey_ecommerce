@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{ var panenkaCsrf = Antiforgery.GetAndStoreTokens(Context).RequestToken; }
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
