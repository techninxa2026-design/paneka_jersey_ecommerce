e"/></symbol><symbol id="youtube" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="4"/><path d="m10 9 5 3-5 3V9Z" fill="currentColor" stroke="none"/></symbol><symbol id="tiktok" viewBox="0 0 24 24"><path d="M13 3v12.2a4.2 4.2 0 1 1-4.1-4.2M13 3c1 3.2 3.3 4.7 6.5 5"/></symbol></svg>

