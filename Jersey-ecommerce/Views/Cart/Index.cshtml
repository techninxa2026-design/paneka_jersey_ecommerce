    .tool{width:26px;height:36px;display:grid;place-items:center;position:relative;border:0;background:none;color:#fff;padding:0}
    .tool:hover{opacity:.72}.tool svg{width:21px;height:21px}.cart-tool{opacity:1}.cart-tool:after{content:"";position:absolute;bottom:-20px;left:0;right:0;height:2px;background:#fff}
    .cart-count{position:absolute;top:-1px;right:-7px;min-width:16px;height:16px;background:#fff;color:#0a0a0a;border-radius:20px;font-size:10px;font-weight:800;display:grid;place-items:center;padding:0 3px}
    .menu-btn,.mobile-menu{display:none}
    .mobile-menu{position:absolute;top:100%;left:0;right:0;background:#0c0e10;padding:7px var(--gutter) 14px;border-top:1px solid #252729;box-shadow:0 20px 35px #0005;z-index:30}
    .mobile-menu a{display:block;padding:13px 0;border-bottom:1px solid #252729;font-size:13px;color:#d6d8da}
    .mobile-menu a.is-active{color:#fff;border-bottom-color:#fff}

    /* Top identity */
    .page-intro{padding-top:49px;padding-bottom:31px;border-bottom:1px solid var(--hair)}
