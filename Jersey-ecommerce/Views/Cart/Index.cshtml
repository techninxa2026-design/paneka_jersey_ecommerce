    .item-stock{display:flex;align-items:center;gap:7px;margin-top:12px;font-size:11px;color:#5d6062}.item-stock:before{content:"";width:6px;height:6px;border-radius:50%;background:#387455}.item-stock.low{color:#ad7333}.item-stock.low:before{background:#c38242}.item-stock.out{color:#b14242}.item-stock.out:before{background:#b14242}
