  <footer class="footer"><div class="container footer-inner"><div class="footer-brand"><a href="/" class="wordmark">PANENKA</a><div class="footer-copy">© <span id="year">2026</span> Panenka. All rights reserved.</div></div><nav class="footer-links" aria-label="Footer links"><a href="/">Home</a><a href="/#arrivals">Shop</a><a href="/#collections">Player Edition</a><a href="/#collections">Retro</a><a href="/#story">About</a><a href="/Account/Login">Account</a></nav><div class="footer-side"><div class="socials"><a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg><use href="#instagram"/></svg></a><a href="https://www.youtube.com/" target="_blank" rel="noopener noreferrer" aria-label="YouTube"><svg><use href="#youtube"/></svg></a><a href="https://www.tiktok.com/" target="_blank" rel="noopener noreferrer" aria-label="TikTok"><svg><use href="#tiktok"/></svg></a></div><p>Football, beyond the ordinary.</p></div></div></footer>
  <div class="toast" role="status" aria-live="polite" id="toast"></div>
  <script>window.PANENKA_CART_API_URL='/api/storefront/cart';window.PANENKA_CHECKOUT_URL='/Checkout/Delivery';window.PANENKA_HOME_URL='/';</script>
  <script>
    'use strict';
    /*
      Live storefront cart: server API is mandatory.
      Suggested backend contract (must be implemented in ASP.NET Core):
      GET    /api/storefront/cart             -> { items:[{id,productId,variantId,name,slug,price,quantity,stockQuantity,size,color,imageUrl,category}],discountAmount?,itemCount? }
      PATCH  /api/storefront/cart/items/{id}  -> JSON { quantity } (quantity>=1)
      DELETE /api/storefront/cart/items/{id}
      POST   /api/storefront/cart/items       -> JSON {productId,variantId,quantity}
      POST   /api/storefront/cart/coupons     -> JSON {code}
      A valid RequestVerificationToken can be added via <meta name="request-verification-token" content="...">.
      All production mutations go to ASP.NET Core with antiforgery protection.
    */
    const IMAGES = [];
    let SAMPLE_PRODUCTS=[];
    // Client-side demo storage is disabled in production.
    const STORE_KEY='panenka_cart_v1';
    const API=String(window.PANENKA_CART_API_URL||'').replace(/\/$/,'');
    const CHECKOUT_URL=window.PANENKA_CHECKOUT_URL||'/Checkout';
    const HOME=window.PANENKA_HOME_URL||'/';
    const $=id=>document.getElementById(id);
    let items=[], discount=0,apiMode=true,busy=false,flashTimer;
    const escapeHtml=t=>String(t??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const money=n=>'৳'+Math.max(0,Number(n)||0).toLocaleString('en-BD',{maximumFractionDigits:2,minimumFractionDigits:0});
    const label=(n)=>n===1?'1 item':`${n} items`;
    const sanitizeUrl=(u)=>{if(typeof u!=='string')return '';const trimmed=u.trim();if(trimmed.startsWith('data:image/'))return trimmed;if(trimmed.startsWith('/')&&!trimmed.startsWith('//'))return trimmed;if(/^https:\/\//i.test(trimmed))return trimmed;return '';};
    const itemKey=p=>String(p.id??`${p.productId}-${p.variantId}`);
    const qtyTotal=()=>items.reduce((s,p)=>s+p.quantity,0);
    function normalize(p,i){
      const numeric=v=>Math.max(0,Number(v)||0);
      const max=numeric(p.stockQuantity??p.availableQuantity??p.stock??99);
      return {id:p.id??p.cartItemId??`${p.productId||i}-${p.variantId||0}`,
        productId:p.productId??p.product?.id??p.id??i,variantId:p.variantId??p.variant?.id??null,
        name:String(p.name??p.productName??p.product?.name??'Football jersey'),slug:String(p.slug??p.product?.slug??''),
        category:String(p.category??p.categoryName??p.product?.categoryName??'Football jersey'),price:numeric(p.price??p.unitPrice??p.product?.basePrice),
        quantity:Math.max(1,Math.floor(Number(p.quantity)||1)),stockQuantity:max,
        size:String(p.size??p.sizeName??p.variant?.sizeName??''),color:String(p.color??p.colorName??p.variant?.colorName??''),
        imageUrl:sanitizeUrl(p.imageUrl??p.product?.imageUrl??''),isNewArrival:Boolean(p.isNewArrival)};
    }
    function showToast(message){const t=$('toast');t.textContent=message;t.classList.add('visible');clearTimeout(flashTimer);flashTimer=setTimeout(()=>t.classList.remove('visible'),3400)}
    function saveDemo(){if(!apiMode){try{localStorage.setItem(STORE_KEY,JSON.stringify(items));}catch{}}}
    function sampleItems(){const existing=SAMPLE_PRODUCTS.slice(0,3);try{const raw=localStorage.getItem(STORE_KEY);if(raw!==null){const saved=JSON.parse(raw);if(Array.isArray(saved))return saved.map(normalize);} }catch{}return existing.map(normalize);}
    function itemStockMessage(p){if(p.stockQuantity<=0)return ['Sold out','out'];if(p.quantity>p.stockQuantity)return ['Quantity exceeds current stock','out'];if(p.stockQuantity<=3)return [`Only ${p.stockQuantity} left in stock`,'low'];return ['In stock',''];}
    function productUrl(p){const slug=encodeURIComponent(p.slug);return `/Product/Details/${encodeURIComponent(p.slug || String(p.productId))}`;}
    function render(){
      const count=qtyTotal(), subtotal=items.reduce((s,p)=>s+p.quantity*p.price,0), total=Math.max(0,subtotal-discount);
      $('navCount').textContent=String(count);$('navCount').hidden=count===0;
      $('lineCount').textContent=`(${label(count)})`;$('summaryCount').textContent=label(count);$('subtotal').textContent=money(subtotal);$('grandTotal').textContent=money(total);
      $('discountRow').hidden=discount<=0;$('discountValue').textContent='−'+money(discount);
      $('checkoutButton').disabled=busy||count===0||items.some(p=>p.stockQuantity<=0||p.quantity>p.stockQuantity);
      $('introSubtitle').textContent=count>0?'Good taste. Great football. You\'re nearly there.':'Your next matchday favorite is waiting.';
      $('cartFoot').hidden=count===0;
      $('previewNotice').classList.toggle('visible',!apiMode);
      $('cartList').innerHTML=items.length?items.map(p=>{
        const [stockNote,stockClass]=itemStockMessage(p);const key=escapeHtml(itemKey(p));const url=escapeHtml(productUrl(p));
        const img=p.imageUrl?`<img src="${escapeHtml(p.imageUrl)}" alt="${escapeHtml(p.name)}" loading="lazy">`:`<svg aria-label="Product image unavailable"><use href="#bag"/></svg>`;
        return `<article class="cart-row" data-key="${key}">
          <a class="item-image" href="${url}" aria-label="View ${escapeHtml(p.name)}">${img}${p.isNewArrival?'<span class="item-new">NEW</span>':''}</a>
          <div class="item-info"><div class="item-category">${escapeHtml(p.category)}</div><a class="item-name" href="${url}">${escapeHtml(p.name)}</a>
          <div class="item-attributes">${p.size?`<span>Size: <strong>${escapeHtml(p.size)}</strong></span>`:''}${p.size&&p.color?'<span class="attribute-dot"></span>':''}${p.color?`<span>Color: <strong>${escapeHtml(p.color)}</strong></span>`:''}</div>
          <div class="item-stock ${stockClass}">${escapeHtml(stockNote)}</div>
          <div class="item-actions"><div class="qty-control" role="group" aria-label="Quantity for ${escapeHtml(p.name)}"><button type="button" data-action="decrease" data-key="${key}" ${busy||p.quantity<=1?'disabled':''} aria-label="Decrease quantity"><svg><use href="#minus"/></svg></button><output aria-live="polite">${p.quantity}</output><button type="button" data-action="increase" data-key="${key}" ${busy||p.quantity>=p.stockQuantity?'disabled':''} aria-label="Increase quantity"><svg><use href="#plus"/></svg></button></div>
          <button type="button" class="text-action" data-action="save" data-key="${key}"><svg><use href="#heart"/></svg> Save</button><button type="button" class="text-action" data-action="remove" data-key="${key}"><svg><use href="#trash"/></svg> Remove</button></div></div>
          <div class="item-price"><strong class="line-total">${money(p.quantity*p.price)}</strong><span class="unit-price">${money(p.price)} / item</span></div>
        </article>`;
      }).join(''):`<div class="empty"><div class="empty-icon"><svg><use href="#bag"/></svg></div><h3>Your bag is empty.</h3><p>Find something special for the next big match.</p><a href="${escapeHtml(HOME)}#arrivals" class="btn-black">EXPLORE THE COLLECTION <svg><use href="#arrow"/></svg></a></div>`;
      const picked=new Set(items.map(p=>String(p.productId)));const choices=SAMPLE_PRODUCTS.filter(p=>!picked.has(String(p.productId))).slice(0,4);
      $('recommendations').hidden=choices.length===0;
      $('recoGrid').innerHTML=choices.map(p=>`<article class="reco"><a class="reco-photo" href="${escapeHtml(productUrl(p))}"><img src="${escapeHtml(p.imageUrl)}" alt="${escapeHtml(p.name)}" loading="lazy"></a><div class="reco-line"><div><a href="${escapeHtml(productUrl(p))}" class="reco-name">${escapeHtml(p.name)}</a><div class="reco-price">${money(p.price)}</div></div><a class="reco-add" href="/shop?search=${encodeURIComponent(p.name)}" aria-label="Choose size and color for ${escapeHtml(p.name)}"><svg><use href="#arrow"/></svg></a></div></article>`).join('');
    }
    function csrfHeaders(){const token=document.querySelector('meta[name="request-verification-token"]')?.content;return token?{'RequestVerificationToken':token}:{};}
    async function request(path,method,body){
      const res=await fetch(API+path,{method,credentials:'same-origin',headers:{'Accept':'application/json',...(body?{'Content-Type':'application/json'}:{}),...csrfHeaders()},...(body?{body:JSON.stringify(body)}:{})});
      if(res.redirected||res.status===401||res.headers.get('content-type')?.includes('text/html')){location.href='/Account/Login?returnUrl='+encodeURIComponent('/Cart');throw Error('Please sign in to view your bag.')}
      if(!res.ok){let msg=`Cart request failed (${res.status}).`;try{const d=await res.json();msg=d.message||d.error||msg}catch{}throw Error(msg)}
      if(res.status===204)return null;
      const contentType=res.headers.get('content-type')||'';return contentType.includes('application/json')?res.json():null;
    }
    async function loadRemote(){
      try{const data=await request('','GET');const rows=Array.isArray(data)?data:Array.isArray(data?.items)?data.items:Array.isArray(data?.cart?.items)?data.cart.items:null;
        if(rows===null)throw Error('Cart API must return an items array.');
        items=rows.map(normalize);discount=Math.max(0,Number(data?.discountAmount??data?.cart?.discountAmount)||0);render();
      }catch(error){items=[];render();$('previewNotice').classList.add('visible');$('previewNotice').querySelector('span').textContent='Could not load your cart. '+error.message;showToast('Cart is unavailable. Please try again.');}
    }
    async function changeQty(key,next){const index=items.findIndex(p=>itemKey(p)===key);if(index<0)return;const target=items[index];if(next<1||next>target.stockQuantity)return;
      if(apiMode){busy=true;render();try{await request(`/items/${encodeURIComponent(key)}`,'PATCH',{quantity:next});await loadRemote()}catch(e){showToast(e.message)}finally{busy=false;render()}}
      else{target.quantity=next;saveDemo();render()}}
    async function removeItem(key){const index=items.findIndex(p=>itemKey(p)===key);if(index<0)return;
      if(apiMode){busy=true;render();try{await request(`/items/${encodeURIComponent(key)}`,'DELETE');await loadRemote();showToast('Removed from your bag.')}catch(e){showToast(e.message)}finally{busy=false;render()}}
      else{items.splice(index,1);saveDemo();render();showToast('Product removed from your bag.')}}
    async function addItem(productId){const product=SAMPLE_PRODUCTS.find(p=>String(p.productId)===String(productId));if(!product)return;
      if(apiMode){busy=true;render();try{await request('/items','POST',{productId:product.productId,variantId:product.variantId,quantity:1});await loadRemote();showToast('Added to your bag.')}catch(e){showToast('Could not add product: '+e.message)}finally{busy=false;render()}}
      else{const existing=items.find(p=>p.productId===product.productId);if(existing){if(existing.quantity>=existing.stockQuantity){showToast('Only the available quantity can be added.');return;}existing.quantity++}else items.push(normalize(product));saveDemo();render();showToast('Added to your bag.')}}
    async function saveFavorite(key){const item=items.find(p=>itemKey(p)===key);if(!item)return;try{await request('/wishlist','POST',{productId:Number(item.productId)});showToast('Saved to your wishlist.')}catch(e){showToast(e.message)}}
    $('cartList').addEventListener('click',event=>{const button=event.target.closest('[data-action]');if(!button||busy)return;const k=button.dataset.key,action=button.dataset.action;if(action==='increase'||action==='decrease'){const item=items.find(p=>itemKey(p)===k);if(item)changeQty(k,item.quantity+(action==='increase'?1:-1))}else if(action==='remove')removeItem(k);else if(action==='save')saveFavorite(k)});
    $('recoGrid').addEventListener('click',event=>{const b=event.target.closest('[data-add]');if(b&&!busy)addItem(b.dataset.add)});
    $('checkoutButton').addEventListener('click',()=>{if(!items.length)return;if(!apiMode){showToast('Design preview: connect your checkout backend to place real orders.');return;}window.location.assign(CHECKOUT_URL)});
    $('promoToggle').addEventListener('click',()=>{const open=$('promoToggle').getAttribute('aria-expanded')!=='true';$('promoToggle').setAttribute('aria-expanded',String(open));$('promoForm').classList.toggle('open',open);if(open)$('promoCode').focus()});
    $('removePromo').addEventListener('click',async()=>{try{await request('/coupons','POST',{code:''});$('promoCode').value='';await loadRemote();showToast('Promo code removed.')}catch(e){showToast(e.message)}});
    $('promoForm').addEventListener('submit',async event=>{event.preventDefault();const code=$('promoCode').value.trim();if(!code){$('promoError').textContent='Enter a promotional code.';$('promoError').classList.add('visible');return;}if(!apiMode){$('promoError').textContent='Promo codes can be verified once the cart backend is connected.';$('promoError').classList.add('visible');return;}
      $('promoError').classList.remove('visible');try{await request('/coupons','POST',{code});await loadRemote();showToast('Promo code checked.')}catch(e){$('promoError').textContent=e.message;$('promoError').classList.add('visible')}});
    // Animated active underline on the same PANENKA header component.
    const nav=$('mainNav'),navLine=$('navLine');const selected=nav.querySelector('a.is-active');
    function underline(el){if(!el)return;const navRect=nav.getBoundingClientRect(),r=el.getBoundingClientRect();navLine.style.width=`${r.width}px`;navLine.style.transform=`translateX(${r.left-navRect.left}px)`;navLine.style.opacity='1'}
    nav.querySelectorAll('a').forEach(a=>{a.addEventListener('mouseenter',()=>underline(a));a.addEventListener('focus',()=>underline(a))});nav.addEventListener('mouseleave',()=>underline(selected));nav.addEventListener('focusout',()=>requestAnimationFrame(()=>{if(!nav.contains(document.activeElement))underline(selected)}));window.addEventListener('resize',()=>underline(selected));window.addEventListener('load',()=>underline(selected));requestAnimationFrame(()=>underline(selected));
    // Mobile navigation: closes when a link is selected, on Escape, or when resized.
    $('menuBtn').addEventListener('click',()=>{const open=$('menuBtn').getAttribute('aria-expanded')==='true';$('menuBtn').setAttribute('aria-expanded',String(!open));$('menuBtn').setAttribute('aria-label',open?'Open navigation':'Close navigation');$('menuBtn').querySelector('use').setAttribute('href',open?'#menu':'#close');$('mobileMenu').classList.toggle('open',!open)});
    $('mobileMenu').addEventListener('click',e=>{if(e.target.closest('a'))closeMenu()});function closeMenu(){$('mobileMenu').classList.remove('open');$('menuBtn').setAttribute('aria-expanded','false');$('menuBtn').setAttribute('aria-label','Open navigation');$('menuBtn').querySelector('use').setAttribute('href','#menu')}
    document.addEventListener('keydown',e=>{if(e.key==='Escape')closeMenu()});window.addEventListener('resize',()=>{if(innerWidth>720)closeMenu()});

    $('year').textContent=String(new Date().getFullYear());
    items=[];render();loadRemote();
    request('/recommendations','GET').then(rows=>{SAMPLE_PRODUCTS=Array.isArray(rows)?rows:[];render();}).catch(()=>{});
  </script>
</body>
</html>
