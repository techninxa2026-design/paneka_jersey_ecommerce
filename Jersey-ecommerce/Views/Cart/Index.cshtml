  <main>
    <section class="page-intro"><div class="container">
      <div class="crumbs"><a href="/">Home</a><span class="divider-mark">/</span><a href="/#arrivals">Shop</a><span class="divider-mark">/</span><span aria-current="page">Your Bag</span></div>
      <div class="intro-grid"><div><div class="overline">YOUR SELECTION / PANENKA</div><h1 class="intro-title">Your bag<span style="color:#999">.</span></h1><p class="intro-sub" id="introSubtitle">Good taste. Great football. You're nearly there.</p></div>
        <div class="checkout-progress" aria-label="Checkout progress"><div class="progress-step current"><span class="num">01</span>Bag</div><span class="progress-rule"></span><div class="progress-step"><span class="num">02</span>Delivery</div><span class="progress-rule"></span><div class="progress-step"><span class="num">03</span>Payment</div></div>
