    @@media(max-width:390px){:root{--gutter:16px}.header-actions{gap:11px}.checkout-progress{gap:7px}.progress-rule{width:12px}.cart-row{grid-template-columns:94px minmax(0,1fr);gap:12px}.item-image{width:94px;height:112px}.item-name{font-size:12.5px}.item-attributes{gap:6px}.item-actions{gap:8px}.text-action{font-size:9px}.intro-title{font-size:39px}.reco{flex-basis:51%}}
    @@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;transition-duration:.01ms!important}}
  </style>
