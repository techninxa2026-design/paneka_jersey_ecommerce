@model Jersey_ecommerce.ViewModels.Checkout.OrderSuccessViewModel
@{ Layout = null; }
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Order received | PANENKA</title><link rel="icon" href="/assets/brands/panekalogo.jpeg"><link rel="stylesheet" href="/css/panenka-checkout.css"></head><body>
@await Html.PartialAsync("_PanenkaCheckoutHeader")
<main class="container"><div class="success-wrap"><div class="success-icon">✓</div><div class="kicker">PANENKA / ORDER PLACED</div><h1>It's in the bag.</h1><p class="lead">Your order has been recorded. Follow its status in your customer account.</p><div class="success-card"><div class="summary-row"><span>Order reference</span><strong>@Model.OrderNumber</strong></div><div class="summary-row"><span>Total</span><strong>৳@Model.Total.ToString("N2")</strong></div><div class="summary-row"><span>Payment method</span><strong>@Model.PaymentMethod</strong></div><div class="summary-row"><span>Payment status</span><strong>@Model.PaymentStatus</strong></div></div>
@if (Model.PaymentMethod == "ManualAdvance")
{
    <p class="notice">@Model.ManualInstructions<br /><strong>Important:</strong> Placing the order is not proof of payment. The store must independently verify receipt before marking the payment paid.</p>
}
else if (Model.PaymentMethod == "Bkash")
{
    <p class="notice"><strong>bKash payment verified.</strong> Your payment was confirmed with the bKash server. You can follow fulfillment in My Orders.</p>
}
else
{
    <p class="notice">Your cash-on-delivery order is recorded. You will pay on delivery; the order is not marked paid yet.</p>
}
<a class="primary" href="/MyOrders">VIEW MY ORDERS <span>→</span></a><a class="back" href="/shop">Continue shopping</a></div></main>@await Html.PartialAsync("_PanenkaCheckoutFooter")</body></html>
