@model Jersey_ecommerce.ViewModels.Checkout.PaymentPageViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    ViewData["Title"] = "Payment | PANENKA";
    bool codAvailable = Model.AllowCashOnDelivery;
    bool bkashAvailable = Model.AllowManualBkash;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Payment | PANENKA</title>
    <link rel="icon" href="/assets/brands/panekalogo.jpeg" />
    <link rel="stylesheet" href="/css/panenka-checkout.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/panenka-premium.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/panenka-manual-bkash.css" asp-append-version="true" />
</head>
<body>
@await Html.PartialAsync("_PanenkaCheckoutHeader")
<section class="container intro">
    <div class="kicker">CHECKOUT / PAYMENT</div>
    <h1>One last step.</h1>
    <p class="lead">Select cash on delivery or transfer through your own bKash app. PANENKA never asks for your bKash PIN or OTP.</p>
    <div class="stepper">
        <div class="step done"><b>01</b> Bag</div><span class="bar"></span>
        <div class="step done"><b>02</b> Delivery</div><span class="bar"></span>
        <div class="step active"><b>03</b> Payment</div>
    </div>
</section>
<main class="container checkout-layout">
    <div>
        <h2 class="panel-heading">How would you like to pay?</h2>
        <p class="hint">Choose a method below. The amount includes your live cart, applied discount and delivery charge.</p>
        @if (TempData["CheckoutError"] is string error)
        {
            <div class="notice error" role="alert">@error</div>
        }
        @if (!codAvailable && !bkashAvailable)
        {
            <div class="notice error" role="alert">Both payment methods are currently unavailable. Please contact PANENKA before placing an order.</div>
        }
        <form asp-controller="Checkout" asp-action="Payment" method="post" id="paymentForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SubmissionToken" value="@Model.SubmissionToken" />

            @if (codAvailable)
            {
                <label class="pay-choice">
                    <input type="radio" name="PaymentMethod" value="COD" checked required />
                    <span><strong>Cash on delivery</strong>
                        <small>Pay in cash after receiving your package. Available inside and outside Dhaka when enabled.</small>
                    </span>
                </label>
            }
            @if (bkashAvailable)
            {
                <label class="pay-choice">
                    <input type="radio" name="PaymentMethod" value="Bkash" checked="@(!codAvailable)" required />
                    <span><strong>bKash · Manual transfer</strong>
                        <small>Place the order, send money to PANENKA's saved bKash number in your bKash app, then submit your transaction ID for verification.</small>
                    </span>
                </label>
                <div id="bkashInfo" class="mb-privacy" style="display:@(codAvailable ? "none" : "block")">
                    <strong><i class="bi bi-wallet2"></i> Manual bKash (not an online gateway)</strong>
                    <p style="margin:8px 0 4px">@Model.ManualBkashInstructions</p>
                    <p style="margin:8px 0 0">After placing the order, you will see the exact receiving number and total. The payment will remain unverified until staff check the merchant wallet independently. Do not send money twice.</p>
                </div>
            }

            <hr class="sep" />
            <h2 class="panel-heading">Deliver to</h2>
            <p class="hint"><strong>@Model.Delivery.FullName</strong> — @Model.Delivery.Phone<br />
                @Model.Delivery.AddressLine1, @Model.Delivery.City, @Model.Delivery.District<br />
                @(Model.Delivery.Region == "Dhaka" ? "Inside Dhaka" : "Outside Dhaka")</p>

            <button type="submit" class="primary" id="placeOrder" disabled="@(!codAvailable && !bkashAvailable)">
                <span id="buttonText">@(codAvailable ? "PLACE ORDER" : "PLACE ORDER & SEE BKASH NUMBER") — ৳@Model.GrandTotal.ToString("N2")</span>
                <span>→</span>
            </button>
            <a class="back" href="/Checkout/Delivery">← Edit delivery details</a>
            <p class="agree">Your order uses saved product prices, quantities, available inventory and delivery rates. Manual bKash requires separate staff confirmation.</p>
        </form>
    </div>
    <aside class="summary">
        <h2>Final summary</h2>
        <div class="summary-row"><span>Subtotal</span><strong>৳@Model.Cart.Subtotal.ToString("N2")</strong></div>
        <div class="summary-row"><span>Discount</span><strong>−৳@Model.Cart.DiscountAmount.ToString("N2")</strong></div>
        <div class="summary-row"><span>Delivery</span><strong>৳@Model.ShippingCost.ToString("N2")</strong></div>
        <div class="summary-total"><span>Order total</span><strong>৳@Model.GrandTotal.ToString("N2")</strong></div>
        <div class="order-lines">
            @foreach (var item in Model.Cart.Items)
            {
                <div class="tiny-line">
                    <span>@item.Name (@item.Size / @item.Color) × @item.Quantity</span>
                    <strong>৳@((item.Price * item.Quantity).ToString("N2"))</strong>
                </div>
            }
        </div>
    </aside>
</main>
@await Html.PartialAsync("_PanenkaCheckoutFooter")
<script>
(() => {
    'use strict';
    const form = document.getElementById('paymentForm');
    const button = document.getElementById('placeOrder');
    const text = document.getElementById('buttonText');
    const info = document.getElementById('bkashInfo');
    const total = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GrandTotal.ToString("N2")));
    function update() {
        const isBkash = document.querySelector('input[name="PaymentMethod"]:checked')?.value === 'Bkash';
        if (info) info.style.display = isBkash ? 'block' : 'none';
        text.textContent = (isBkash ? 'PLACE ORDER & SEE BKASH NUMBER' : 'PLACE ORDER') + ' — ৳' + total;
    }
    form.querySelectorAll('input[name="PaymentMethod"]').forEach(x => x.addEventListener('change', update));
    form.addEventListener('submit', () => {
        if (!form.checkValidity()) return;
        button.disabled = true;
        text.textContent = 'RECORDING ORDER…';
    });
    update();
})();
</script>
</body>
</html>
