@model Jersey_ecommerce.Controllers.ManualBkashStatusModel
@{
    Layout = null;
    ViewData["Title"] = "Manual bKash | PANENKA";
    var paid = Model.PaymentStatus == "Paid";
    var submitted = Model.PaymentStatus == "Submitted";
    var rejected = Model.PaymentStatus == "Rejected";
    var dateLocal = (Model.ClaimedPaidAtUtc?.AddHours(6) ?? DateTime.UtcNow.AddHours(6)).ToString("yyyy-MM-ddTHH:mm");
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content="Report your manual bKash transfer securely for staff verification." />
    <title>Manual bKash payment | PANENKA</title>
    <link rel="icon" href="/assets/brands/panekalogo.jpeg" />
    <link rel="stylesheet" href="/css/panenka-checkout.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/panenka-premium.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/panenka-manual-bkash.css" asp-append-version="true" />
</head>
<body>
@await Html.PartialAsync("_PanenkaCheckoutHeader")
<section class="container intro">
    <div class="kicker">CHECKOUT / MANUAL PAYMENT</div>
    <h1>bKash transfer.</h1>
    <p class="lead">Send Money in your own bKash app, then record the transfer details here for independent store verification.</p>
</section>
<main class="container mb-manual">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="mb-alert mb-alert-error" role="alert">@Model.Error</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Notice))
    {
        <div class="mb-alert mb-alert-success" role="status">@Model.Notice</div>
    }
    <div class="mb-stepper">
        <span>01 · ORDER CREATED</span><i class="bi bi-chevron-right"></i>
        <span class="@(Model.CanSubmit ? "current" : "")">02 · SEND MONEY</span><i class="bi bi-chevron-right"></i>
        <span class="@(submitted ? "current" : "")">03 · STAFF VERIFICATION</span><i class="bi bi-chevron-right"></i>
        <span class="@(paid ? "current" : "")">04 · CONFIRMED</span>
    </div>
    <div class="mb-manual-grid">
        <div>
            <section class="mb-card mb-card-pad">
                <div class="mb-card-head">
                    <div>
                        <div class="mb-eyebrow">ORDER @Model.OrderNumber</div>
                        <h2>Manual bKash transfer</h2>
                        <p>The receiving wallet and amount below are saved with your order.</p>
                    </div>
                    <span class="mb-brand-pill"><i class="bi bi-wallet2"></i> BKASH</span>
                </div>
                <div class="mb-due"><span>Exact amount to send</span><strong>৳@Model.Amount.ToString("N2")</strong></div>
                @if (!string.IsNullOrWhiteSpace(Model.RecipientNumber))
                {
                    <div class="mb-number">
                        <div>
                            <small>RECEIVING BKASH NUMBER</small>
                            <strong id="receivingNumber">@Model.RecipientNumber</strong>
                        </div>
                        <button type="button" id="copyReceivingNumber" class="mb-copy" disabled="@(!Model.ReceivingAccountIsCurrent && !paid)" aria-label="Copy bKash receiving number">
                            <i class="bi bi-clipboard"></i> COPY
                        </button>
                    </div>
                }
                else
                {
                    <div class="mb-alert mb-alert-error">A receiving number was not saved for this older order. Please contact PANENKA support instead of sending money to an unconfirmed number.</div>
                }
                @if (!Model.ReceivingAccountIsCurrent && !paid)
                {
                    <div class="mb-alert mb-alert-error" role="alert">
                        <strong>This receiving number is no longer the store's current bKash account.</strong>
                        Do not make a new transfer to this number. If you already transferred before the account changed,
                        you may submit your earlier transaction details for reconciliation. Otherwise contact PANENKA support.
                    </div>
                }
                else
                {
                    <p class="mb-note">@Model.Instructions</p>
                }
                @if (Model.ReceivingAccountIsCurrent)
                {
                <ol class="mb-guide">
                    <li>Open your own official <strong>bKash app</strong>, then select <strong>Send Money</strong>.</li>
                    <li>Enter the receiving number shown above. Verify the recipient inside bKash before sending.</li>
                    <li>Send the exact amount of <strong>৳@Model.Amount.ToString("N2")</strong> from your wallet.</li>
                    <li>Copy the transaction ID (TrxID) from your bKash confirmation and complete the form on this page.</li>
                    <li>The PANENKA admin will independently check receipt and confirm your order.</li>
                </ol>
                }
                <div class="mb-privacy"><i class="bi bi-shield-lock"></i> We will never ask for your bKash PIN, password, or OTP. This website does not process the transfer itself.</div>
            </section>
            <p style="margin:19px 0"><a class="back" href="/MyOrders/@Model.OrderId">← Back to your order</a></p>
        </div>
        <div>
            <section class="mb-card mb-card-pad">
                @if (paid)
                {
                    <div class="mb-payment-state is-paid">
                        <div class="mb-state-icon"><i class="bi bi-check-lg"></i></div>
                        <h2>Payment verified.</h2>
                        <p>Our team has confirmed the transfer. Your order can now move into fulfillment.</p>
                    </div>
                }
                else if (submitted)
                {
                    <div class="mb-payment-state is-submitted">
                        <div class="mb-state-icon"><i class="bi bi-hourglass-split"></i></div>
                        <h2>Awaiting verification.</h2>
                        <p>Your details have been recorded. An administrator must confirm that funds reached the receiving wallet before the order is marked paid.</p>
                    </div>
                }
                else if (rejected)
                {
                    <div class="mb-alert mb-alert-error" role="alert">
                        <strong>Payment details need correction.</strong>
                        <p style="margin:5px 0 0">@(string.IsNullOrWhiteSpace(Model.ReviewNote) ? "The submitted transfer could not be verified." : Model.ReviewNote)</p>
                        <p style="margin:5px 0 0">Check the actual transfer in your bKash account and submit corrected details below. Do not send the amount again until you confirm what happened.</p>
                    </div>
                }
                @if (Model.CanSubmit)
                {
                    <div class="mb-card-head">
                        <div>
                            <div class="mb-eyebrow">TRANSACTION REFERENCE</div>
                            <h2>@(rejected ? "Correct transfer details" : "I've sent the payment")</h2>
                            <p>Enter only the details from the completed transfer. The staff team will verify them.</p>
                        </div>
                    </div>
                    <form action="/Checkout/Bkash/Submit/@Model.OrderId" method="post" class="mb-form" id="manualBkashForm">
                        @Html.AntiForgeryToken()
                        <div class="mb-field">
                            <label for="senderNumber">Your bKash sender number</label>
                            <input id="senderNumber" name="senderNumber" type="tel" inputmode="numeric"
                                   autocomplete="tel" maxlength="11" minlength="11" pattern="01[3-9][0-9]{8}"
                                   value="@Model.SenderNumber" placeholder="01XXXXXXXXX" required />
                            <small>The mobile number you used to send this payment.</small>
                        </div>
                        <div class="mb-field">
                            <label for="transactionId">bKash transaction ID (TrxID)</label>
                            <input id="transactionId" name="transactionId" type="text" autocomplete="off"
                                   maxlength="40" minlength="7" pattern="[a-zA-Z0-9-]{7,40}"
                                   value="@(rejected ? "" : Model.TransactionId)" placeholder="e.g. BXXXXXXXXX" required />
                            <small>Find the transaction ID in your bKash transaction confirmation.</small>
                        </div>
                        <div class="mb-field">
                            <label for="paidAtLocal">Payment date and time (Bangladesh time)</label>
                            <input id="paidAtLocal" name="paidAtLocal" type="datetime-local"
                                   value="@dateLocal" required />
                            <small>Enter the actual transfer time shown in your bKash records.</small>
                        </div>
                        <button type="submit" class="mb-button mb-button-pink" id="submitClaim">
                            SUBMIT TRANSACTION FOR VERIFICATION <i class="bi bi-arrow-right"></i>
                        </button>
                        <p class="mb-note">By submitting, you report that you made a transfer. Your order remains unpaid until staff verify receipt.</p>
                    </form>
                }
                else if (submitted || paid)
                {
                    <div class="mb-card-head" style="margin-top:12px">
                        <div><div class="mb-eyebrow">YOUR RECEIPT</div><h2>Recorded payment details</h2></div>
                    </div>
                    <div class="mb-detail-row"><span>Order</span><strong>@Model.OrderNumber</strong></div>
                    <div class="mb-detail-row"><span>Sender</span><strong>@Model.SenderNumber</strong></div>
                    <div class="mb-detail-row"><span>TrxID</span><strong>@Model.TransactionId</strong></div>
                    <div class="mb-detail-row"><span>Reported time (BDT)</span><strong>@(Model.ClaimedPaidAtUtc?.AddHours(6).ToString("dd MMM yyyy, hh:mm tt") ?? "—")</strong></div>
                    <div class="mb-detail-row"><span>Submitted (BDT)</span><strong>@(Model.SubmittedAtUtc?.AddHours(6).ToString("dd MMM yyyy, hh:mm tt") ?? "—")</strong></div>
                    @if (paid)
                    {
                        <div class="mb-detail-row"><span>Verified by staff (BDT)</span><strong>@(Model.ReviewedAtUtc?.AddHours(6).ToString("dd MMM yyyy, hh:mm tt") ?? "—")</strong></div>
                    }
                }
                else
                {
                    <div class="mb-payment-state">
                        <div class="mb-state-icon"><i class="bi bi-headset"></i></div>
                        <h2>Contact store support.</h2>
                        <p>This payment cannot accept a new transfer submission. Review your order details for the latest information.</p>
                    </div>
                }
                <a class="mb-button mb-button-outline" href="/MyOrders/@Model.OrderId" style="margin-top:23px;width:100%">
                    VIEW ORDER STATUS <i class="bi bi-arrow-right"></i>
                </a>
            </section>
        </div>
    </div>
</main>
@await Html.PartialAsync("_PanenkaCheckoutFooter")
<script>
(() => {
    const copy = document.getElementById('copyReceivingNumber');
    copy?.addEventListener('click', async () => {
        const text = document.getElementById('receivingNumber')?.textContent?.trim();
        if (!text) return;
        try { await navigator.clipboard.writeText(text); copy.textContent = 'COPIED ✓'; }
        catch { copy.textContent = 'SELECT THE NUMBER ABOVE'; }
    });
    const form = document.getElementById('manualBkashForm');
    form?.addEventListener('submit', () => {
        if (!form.checkValidity()) return;
        const button = document.getElementById('submitClaim');
        button.disabled = true;
        button.textContent = 'RECORDING DETAILS…';
    });
})();
</script>
</body>
</html>
