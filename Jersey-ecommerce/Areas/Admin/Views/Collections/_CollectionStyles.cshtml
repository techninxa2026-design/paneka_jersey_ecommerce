<style>
    /* PANENKA / Collections — styles are embedded in a Razor partial so design
       cannot disappear because a wwwroot CSS file was not copied. */
    .pc-page { max-width: 1260px; margin: 0 auto; color: #171717; font-family: inherit; font-size: 13px; }
    .pc-page *, .pc-page *::before, .pc-page *::after { box-sizing: border-box; }
    .pc-page a { text-decoration: none; }
    .pc-page .pc-top { display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:26px;flex-wrap:wrap; }
    .pc-eyebrow { font-size:10px;font-weight:800;letter-spacing:1.7px;text-transform:uppercase;color:#888;margin-bottom:7px; }
    .pc-page h1 { margin:0;font-size:33px;font-weight:850;line-height:1.12;letter-spacing:-1.3px; }
    .pc-subtitle { margin:10px 0 0;color:#818181;font-size:12px;line-height:1.65; }
    .pc-crumb { margin-bottom:13px;display:flex;align-items:center;gap:10px;color:#909090;font-size:11px;flex-wrap:wrap; }
    .pc-crumb a { color:#666; }
    .pc-crumb a:hover { color:#101010; }
    .pc-actions { display:flex;gap:10px;flex-wrap:wrap; }
    .pc-btn { min-height:42px;padding:0 16px;display:inline-flex;align-items:center;justify-content:center;gap:9px;border:1px solid #ddd;background:white;color:#222;font-size:12px;font-weight:750;cursor:pointer;transition:.15s ease;font-family:inherit; }
    .pc-btn:hover { background:#f4f4f4;color:#111;border-color:#bdbdbd; }
    .pc-btn-dark { background:#111;color:white;border-color:#111; }
    .pc-btn-dark:hover { background:#323232;color:white;border-color:#323232; }
    .pc-btn-danger { color:#b42318;border-color:#edd4d2;background:#fff; }
    .pc-btn-danger:hover { background:#fff4f3;color:#b42318;border-color:#e4b7b2; }
    .pc-btn-sm { min-height:33px;padding:0 11px;font-size:11px; }
    .pc-card { background:#fff;border:1px solid #e9e9e9;min-width:0; }
    .pc-card-heading { padding:20px 22px;display:flex;align-items:center;gap:12px;border-bottom:1px solid #eee; }
    .pc-step { height:35px;width:35px;background:#f3f3f3;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:850;flex:0 0 auto; }
    .pc-card h2 { font-size:14px;font-weight:850;margin:0 0 5px;letter-spacing:-.2px; }
    .pc-muted { font-size:11px;color:#8a8a8a;line-height:1.6;margin:0; }
    .pc-card-body { padding:23px; }
    .pc-stats { display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px;margin-bottom:20px; }
    .pc-stat { border:1px solid #eaeaea;background:white;padding:20px 21px;position:relative;overflow:hidden; }
    .pc-stat:before { content:'';position:absolute;top:0;right:0;width:60px;height:3px;background:#171717; }
    .pc-stat-k { display:flex;align-items:center;justify-content:space-between;color:#8c8c8c;font-size:10px;font-weight:750;letter-spacing:.75px;text-transform:uppercase; }
    .pc-stat-value { font-size:31px;letter-spacing:-1.1px;font-weight:850;line-height:1.2;margin-top:12px; }
    .pc-stat-note { margin-top:6px;font-size:10px;color:#959595; }
    .pc-toolbar { padding:17px 20px;display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;border-bottom:1px solid #eee; }
    .pc-filters { display:flex;gap:8px;align-items:center;flex-wrap:wrap;flex:1; }
    .pc-input,.pc-select,.pc-textarea { display:block;width:100%;outline:none;border:1px solid #dedede;border-radius:0;background:#fff;color:#222;min-height:43px;padding:10px 13px;font:inherit;font-size:12px; }
    .pc-input:focus,.pc-select:focus,.pc-textarea:focus { border-color:#6c6c6c;box-shadow:0 0 0 3px rgba(0,0,0,.035); }
    .pc-textarea { min-height:120px;resize:vertical;line-height:1.65; }
    .pc-search { max-width:320px;min-width:200px;flex:1;position:relative; }
    .pc-search .pc-input { padding-left:36px; }
    .pc-search i { position:absolute;left:13px;top:15px;color:#999; }
    .pc-select { width:auto;min-width:135px; }
    .pc-table-wrap { width:100%;overflow:auto; }
    .pc-table { width:100%;border-collapse:collapse;white-space:nowrap; }
    .pc-table th { padding:15px 19px;text-align:left;text-transform:uppercase;font-size:10px;letter-spacing:.8px;font-weight:800;color:#8a8a8a;background:#fbfbfb;border-bottom:1px solid #eee; }
    .pc-table td { padding:16px 19px;border-bottom:1px solid #f0f0f0;vertical-align:middle;font-size:12px;color:#545454; }
    .pc-table tbody tr:last-child td { border-bottom:0; }
    .pc-table tbody tr:hover { background:#fcfcfc; }
    .pc-media-cell { display:flex;align-items:center;gap:13px;min-width:210px; }
    .pc-thumb { height:58px;width:78px;overflow:hidden;display:flex;justify-content:center;align-items:center;background:#f3f3f0;border:1px solid #ededed;flex:0 0 auto; }
    .pc-thumb img { display:block;width:100%;height:100%;object-fit:cover; }
    .pc-item-name { display:block;font-size:12px;font-weight:850;color:#1d1d1d; }
    .pc-item-sub { display:block;font-size:10px;color:#929292;margin-top:5px; }
    .pc-badge { display:inline-flex;align-items:center;gap:7px;padding:6px 10px;font-size:10px;font-weight:800;border:1px solid #e5e5e5;color:#444;background:#f7f7f7; }
    .pc-badge::before { content:'';height:6px;width:6px;border-radius:50%;background:#9e9e9e; }
    .pc-badge-active { background:#f4faf5;border-color:#dfebe0;color:#326b3f; }
    .pc-badge-active::before { background:#3c8b4d; }
    .pc-icon-actions { display:flex;align-items:center;justify-content:flex-end;gap:7px; }
    .pc-icon-btn { display:grid;place-items:center;width:33px;height:33px;border:1px solid #e4e4e4;color:#444;background:#fff; }
    .pc-icon-btn:hover { background:#111;border-color:#111;color:white; }
    .pc-icon-btn-danger:hover { background:#b42318;border-color:#b42318;color:white; }
    .pc-footnote { padding:16px 20px;border-top:1px solid #eee;font-size:11px;color:#9a9a9a; }
    .pc-empty { padding:58px 20px;text-align:center;color:#999; }
    .pc-empty i { display:block;font-size:33px;margin-bottom:12px;color:#b7b7b7; }
    .pc-empty strong { display:block;color:#333;font-size:15px;margin-bottom:6px; }
    .pc-alert { border:1px solid #edd2cf;background:#fff7f6;color:#99271c;padding:14px 17px;margin-bottom:18px;font-size:12px;line-height:1.6; }
    .pc-alert-success { border-color:#d6e8da;background:#f5fbf6;color:#306239; }
    .pc-alert ul { margin:7px 0 0;padding-left:18px; }
    .pc-validation.validation-summary-valid { display:none; }
    .pc-form-layout { display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:20px;align-items:start; }
    .pc-stack { display:flex;flex-direction:column;gap:19px;min-width:0; }
    .pc-field { margin-bottom:20px; }
    .pc-field:last-child { margin-bottom:0; }
    .pc-label { display:block;color:#303030;font-size:11px;font-weight:800;margin-bottom:8px; }
    .pc-required { color:#b42318; }
    .pc-help { margin-top:8px;color:#939393;font-size:10px;line-height:1.65; }
    .pc-error { display:block;font-size:11px;color:#b42318;margin-top:6px; }
    .pc-upload { width:100%;padding:13px;background:#fbfbfb;border:1px dashed #bcbcbc;color:#333;font-size:11px; }
    .pc-upload::file-selector-button { padding:9px 12px;background:white;border:1px solid #ddd;margin-right:12px;font-size:11px;cursor:pointer; }
    .pc-preview { display:flex;justify-content:center;align-items:center;width:100%;aspect-ratio:16/10;overflow:hidden;background:#f5f4f0;border:1px solid #e9e9e9;margin-top:16px; }
    .pc-preview img { width:100%;height:100%;object-fit:contain;display:none; }
    .pc-placeholder { text-align:center;color:#9b9b9b;padding:18px; }
    .pc-placeholder i { display:block;font-size:30px;margin-bottom:8px; }
    .pc-placeholder b { display:block;color:#666;font-size:12px; }
    .pc-placeholder small { font-size:10px; }
    .pc-switch-row { display:flex;align-items:center;justify-content:space-between;gap:14px; }
    .pc-switch { appearance:none;-webkit-appearance:none;cursor:pointer;position:relative;width:44px;height:25px;flex:none;margin:0;border-radius:30px;background:#d1d1d1;border:1px solid #c9c9c9;transition:.15s; }
    .pc-switch::before { content:'';position:absolute;top:3px;left:3px;border-radius:50%;width:17px;height:17px;background:white;transition:transform .15s; }
    .pc-switch:checked { background:#181818;border-color:#181818; }
    .pc-switch:checked::before { transform:translateX(19px); }
    .pc-switch:focus-visible { outline:2px solid #666;outline-offset:3px; }
    .pc-divider { height:1px;background:#ededed;margin:18px 0; }
    .pc-info { background:#faf9f6;border:1px solid #eeeae3;padding:15px 17px;line-height:1.7;font-size:11px;color:#757575; }
    .pc-info strong { color:#272727;display:block;margin-bottom:5px; }
    .pc-panel-save { padding:19px;border:1px solid #e9e9e9;background:#fff; }
    .pc-panel-save strong { display:block;font-size:13px;margin-bottom:5px; }
    .pc-panel-save p { color:#949494;font-size:11px;line-height:1.65;margin:0 0 15px; }
    .pc-panel-save .pc-btn { display:flex;width:100%;margin-top:9px; }
    .pc-meta { font-size:11px;color:#777;line-height:1.9;padding:16px;background:#fafafa;border:1px solid #eee; }
    .pc-meta strong { color:#333; }
    .pc-danger-panel { border:1px solid #eacac7;background:#fff8f7;padding:22px; }
    .pc-danger-panel h2 { font-size:19px;font-weight:850;margin:0 0 10px; }
    .pc-danger-panel p { font-size:12px;line-height:1.8;color:#815e5b; }
    .pc-products-heading { padding:18px 20px;border-bottom:1px solid #eee;display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap; }
    .pc-product-list { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));max-height:540px;overflow:auto; }
    .pc-product-check { display:flex;align-items:center;gap:12px;padding:16px 20px;border-right:1px solid #f0f0f0;border-bottom:1px solid #f0f0f0;cursor:pointer;min-width:0; }
    .pc-product-check:hover { background:#fafafa; }
    .pc-product-check input { flex:none;width:18px;height:18px;accent-color:#171717;cursor:pointer; }
    .pc-product-check b { display:block;font-size:12px;color:#333;overflow-wrap:anywhere; }
    .pc-product-check small { display:block;color:#999;font-size:10px;margin-top:5px;overflow-wrap:anywhere; }
    .pc-prod-foot { padding:17px 20px;display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap;border-top:1px solid #eee; }
    .pc-is-hidden { display:none!important; }
    @@media(max-width:1000px) { .pc-stats { grid-template-columns:repeat(2,minmax(0,1fr)); } }
    @@media(max-width:820px) { .pc-form-layout { grid-template-columns:1fr; } }
    @@media(max-width:640px) { .pc-page h1 { font-size:27px; }.pc-stats { gap:9px; }.pc-stat { padding:15px; }.pc-stat-value { font-size:26px; }.pc-toolbar { align-items:stretch; }.pc-search { max-width:none;min-width:100%; }.pc-filters { width:100%; }.pc-filters .pc-btn { flex:1; }.pc-product-list { grid-template-columns:1fr; }.pc-product-check { border-right:0; }.pc-top>.pc-btn { width:100%; }.pc-card-body { padding:18px; } }
</style>
