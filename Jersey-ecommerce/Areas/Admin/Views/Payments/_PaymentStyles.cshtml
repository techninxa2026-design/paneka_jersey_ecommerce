<style>
/* PANENKA / PAYMENTS — loaded via Razor partial; no external CSS dependency. */
.pp-page{max-width:1320px;margin:0 auto;color:#191919;font-size:13px}
.pp-page *,.pp-page *::before,.pp-page *::after{box-sizing:border-box}
.pp-page a{text-decoration:none}
.pp-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin:0 0 24px}
.pp-crumb{display:flex;gap:9px;align-items:center;flex-wrap:wrap;color:#999;font-size:11px;margin-bottom:12px}
.pp-crumb a{color:#777}.pp-crumb a:hover{color:#111}
.pp-kicker{font-size:10px;font-weight:800;letter-spacing:1.7px;color:#999;text-transform:uppercase;margin-bottom:8px}
.pp-title{font-weight:850;letter-spacing:-1.3px;font-size:34px;line-height:1.1;margin:0}
.pp-subtitle{color:#888;font-size:12px;margin:11px 0 0;line-height:1.65;max-width:740px}
.pp-head-actions,.pp-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.pp-btn{display:inline-flex;justify-content:center;align-items:center;gap:8px;min-height:42px;padding:0 16px;border:1px solid #dedede;background:#fff;color:#252525;font:inherit;font-size:12px;font-weight:750;cursor:pointer;white-space:nowrap;transition:.15s}
.pp-btn:hover{color:#111;background:#f5f5f5}.pp-btn-primary{background:#111;border-color:#111;color:#fff}.pp-btn-primary:hover{background:#333;color:#fff}
.pp-btn-small{min-height:34px;padding:0 11px;font-size:11px}
.pp-stats{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;margin-bottom:19px}
.pp-stat{background:#fff;border:1px solid #e7e7e7;padding:19px;min-width:0;position:relative;overflow:hidden}
.pp-stat:before{content:"";position:absolute;right:0;top:0;width:52px;height:3px;background:#1b1b1b}
.pp-stat-label{display:flex;align-items:center;gap:8px;color:#999;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.7px}
.pp-stat-value{font-size:30px;font-weight:850;letter-spacing:-1px;line-height:1.2;margin-top:12px;overflow-wrap:anywhere}
.pp-stat-hint{color:#999;font-size:10px;line-height:1.65;margin-top:8px}
.pp-card{background:#fff;border:1px solid #e7e7e7;min-width:0}
.pp-card-head{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;padding:18px 21px;border-bottom:1px solid #eee}
.pp-card-title{font-size:14px;font-weight:850;margin:0}.pp-card-desc{color:#999;font-size:11px;line-height:1.65;margin:5px 0 0}
.pp-card-body{padding:21px}
.pp-filters{display:grid;grid-template-columns:minmax(170px,2fr) repeat(4,minmax(108px,1fr)) auto;gap:10px;align-items:end}
.pp-filters-transaction{grid-template-columns:minmax(210px,2fr) minmax(150px,1fr) minmax(150px,1fr) auto}
.pp-label{display:block;margin-bottom:7px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.6px;color:#737373}
.pp-input,.pp-select{width:100%;min-height:42px;background:#fff;border:1px solid #dedede;border-radius:0;color:#222;padding:10px 11px;font:inherit;font-size:12px;outline:0}
.pp-input:focus,.pp-select:focus{border-color:#555;box-shadow:0 0 0 3px #00000008}
.pp-filter-actions{display:flex;gap:7px}
.pp-table-wrap{overflow-x:auto;max-width:100%}
.pp-table{width:100%;border-collapse:collapse;min-width:940px}
.pp-table th{text-align:left;padding:14px 19px;font-size:10px;font-weight:800;letter-spacing:.8px;text-transform:uppercase;color:#999;background:#fcfcfc;border-bottom:1px solid #eee;white-space:nowrap}
.pp-table td{padding:17px 19px;color:#555;border-bottom:1px solid #f1f1f1;font-size:12px;vertical-align:middle}
.pp-table tbody tr:hover{background:#fcfcfc}.pp-table tr:last-child td{border-bottom:0}
.pp-link{font-weight:850;color:#151515}.pp-link:hover{color:#111;text-decoration:underline}
.pp-primary-text{font-weight:800;color:#252525}.pp-secondary-text{color:#999;font-size:10px;margin-top:5px;line-height:1.5}
.pp-badge{display:inline-flex;gap:7px;align-items:center;border:1px solid #e5e5e5;background:#f8f8f8;color:#666;padding:6px 10px;font-size:10px;font-weight:800;white-space:nowrap}
.pp-badge:before{content:"";width:6px;height:6px;border-radius:50%;background:#999}
.pp-pending{background:#fffaf0;border-color:#f2e4bd;color:#896519}.pp-pending:before{background:#bf9122}
.pp-success{background:#f1faf4;border-color:#d2ebd9;color:#2d7143}.pp-success:before{background:#329653}
.pp-failed{background:#fff4f2;border-color:#f2d7d3;color:#a4443c}.pp-failed:before{background:#d46e61}
.pp-reversed{background:#f6f2fb;border-color:#e3d9ef;color:#795997}.pp-reversed:before{background:#906fba}
.pp-muted{color:#989898;font-size:11px;line-height:1.6}
.pp-empty{padding:65px 25px;text-align:center;color:#999}.pp-empty i{font-size:34px;display:block;margin-bottom:12px}
.pp-empty strong{display:block;font-size:15px;color:#333;margin-bottom:6px}
.pp-foot{padding:16px 21px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;border-top:1px solid #eee}
.pp-pages{display:flex;align-items:center;gap:7px}.pp-current{font-size:11px;font-weight:750;color:#555;padding:0 7px}
.pp-alert{padding:14px 17px;margin-bottom:19px;border:1px solid #e6dfd3;background:#fcfaf6;color:#766e5d;font-size:11px;line-height:1.75}
.pp-details-grid{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:18px;align-items:start}
.pp-stack{display:flex;flex-direction:column;gap:18px;min-width:0}
.pp-data-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 24px}
.pp-data-label{text-transform:uppercase;letter-spacing:.7px;font-size:10px;color:#999;font-weight:800;margin-bottom:7px}
.pp-data-value{font-size:12px;color:#252525;line-height:1.7;overflow-wrap:anywhere}
.pp-highlight{padding:19px 21px;background:#161616;color:#fff;display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap}
.pp-highlight .pp-h-label{font-size:10px;letter-spacing:1px;text-transform:uppercase;color:#bcbcbc;font-weight:800}
.pp-highlight .pp-h-value{font-size:28px;line-height:1.1;font-weight:850;margin-top:8px;letter-spacing:-.8px}
.pp-timeline{list-style:none;padding:0 0 0 14px;margin:0;border-left:1px solid #e5e5e5}
.pp-event{padding:0 0 24px 18px;position:relative}.pp-event:last-child{padding-bottom:0}
.pp-event:before{content:"";position:absolute;left:-19px;top:4px;width:9px;height:9px;border-radius:50%;border:2px solid #fff;box-shadow:0 0 0 1px #aaa;background:#191919}
.pp-event-name{font-weight:800;color:#222}.pp-event-meta{color:#999;font-size:10px;margin-top:5px;line-height:1.7}
.pp-event-reason{color:#a54b40;font-size:11px;line-height:1.7;margin-top:8px;overflow-wrap:anywhere}
.pp-mini{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.pp-note{border:1px solid #e8e3d8;background:#faf9f5;padding:14px 16px;color:#736d5e;font-size:11px;line-height:1.75}
.pp-tx-label{border:1px solid #e9e9e9;background:#f8f8f8;color:#777;padding:4px 8px;font-size:10px}
@@media(max-width:1150px){.pp-stats{grid-template-columns:repeat(3,minmax(0,1fr))}.pp-filters{grid-template-columns:repeat(3,minmax(0,1fr))}}
@@media(max-width:900px){.pp-details-grid{grid-template-columns:1fr}.pp-stats{grid-template-columns:repeat(2,minmax(0,1fr))}}
@@media(max-width:620px){.pp-title{font-size:28px}.pp-stats{gap:9px}.pp-stat{padding:14px}.pp-stat-value{font-size:25px}.pp-filters,.pp-filters-transaction{grid-template-columns:1fr}.pp-filter-actions .pp-btn{flex:1}.pp-card-body,.pp-card-head{padding:16px}.pp-head-actions{width:100%}.pp-head-actions .pp-btn{flex:1}.pp-data-grid,.pp-mini{grid-template-columns:1fr}}
@@media print{body{background:white!important}.admin-sidebar,.admin-topbar,.admin-footer,.pp-no-print,.pp-filter-actions,.pp-foot{display:none!important}.admin-main,.admin-content{margin:0!important;padding:0!important}.pp-page{max-width:none!important}.pp-details-grid{grid-template-columns:1fr}.pp-card{break-inside:avoid}.pp-head{margin-bottom:13px}.pp-title{font-size:24px}}
</style>
