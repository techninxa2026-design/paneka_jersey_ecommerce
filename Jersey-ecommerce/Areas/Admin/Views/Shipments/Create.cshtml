@model Jersey_ecommerce.Areas.Admin.ViewModels.ShipmentFormViewModel
@{
    ViewData["Title"] = "Create Shipment";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var createUrl = Url.Action("Create", "Shipments", new { area = "Admin" });
    var indexUrl = Url.Action("Index", "Shipments", new { area = "Admin" });
    var noOrders = Model.AvailableOrders == null || Model.AvailableOrders.Count == 0;
}
<link rel="stylesheet" href="@Url.Content("~/css/admin-shipments.css")" />
<div class="ship-page">
    <div class="ship-head">
        <div>
            <div class="ship-kicker">Sales / Shipments / Create</div>
            <h2 class="ship-title">Create shipment</h2>
            <p class="ship-subtitle">Attach a delivery record to an order that has not been shipped yet.</p>
        </div>
        <a href="@indexUrl" class="ship-btn ship-btn-light">
            <i class="bi bi-arrow-left"></i> All shipments
        </a>
    </div>

    <div class="ship-form-wrap">
        <div class="ship-card">
            <div class="ship-card-head"><h3 class="ship-card-title">Delivery information</h3></div>
            <form action="@createUrl" method="post" autocomplete="off">
                @Html.AntiForgeryToken()
                <div class="ship-form-body">
                    @await Html.PartialAsync("_Form", Model)
                </div>
                <div class="ship-form-footer">
                    <button type="submit" class="ship-btn" disabled="@noOrders">
                        <i class="bi bi-check2"></i> Save shipment
                    </button>
                    <a href="@indexUrl" class="ship-btn ship-btn-light">Cancel</a>
                </div>
            </form>
        </div>
        <aside class="ship-card">
            <div class="ship-card-head"><h3 class="ship-card-title">How it works</h3></div>
            <div class="ship-hint">
                <p><strong>One shipment per order.</strong> Only orders without shipments appear in the selector.</p>
                <p>Choose <strong>Pending</strong> to save a record before assigning a courier.</p>
                <p>A courier is required when marking a shipment Shipped, In transit, Out for delivery or Delivered.</p>
                <p class="mb-0">Shipment creation records tracking details. It does not book a courier pickup.</p>
            </div>
        </aside>
    </div>
</div>
