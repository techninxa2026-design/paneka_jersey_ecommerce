@model Jersey_ecommerce.Areas.Admin.ViewModels.CustomerDetailsViewModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Customer Details";

    var indexUrl = Url.Content("~/Admin/Customers");

    var editUrl = Url.Action(
        "Edit", "Customers",
        new { area = "Admin", id = Model.Id });

    var toggleUrl = Url.Action(
        "ToggleStatus", "Customers",
        new { area = "Admin", id = Model.Id });

    var deleteUrl = Url.Action(
        "Delete", "Customers",
        new { area = "Admin", id = Model.Id });

    var initials = string.IsNullOrWhiteSpace(Model.FullName)
        ? "?"
        : Model.FullName.Substring(0, 1).ToUpperInvariant();
}

<link rel="stylesheet"
      href="@Url.Content("~/css/admin-customers.css")" />

<style>
    .cd-page {
        max-width: 1380px;
        margin: 0 auto;
        color: #171717;
    }

        .cd-page * {
            box-sizing: border-box;
        }

    .cd-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 28px;
    }

    .cd-eyebrow {
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 2px;
        color: #888;
        text-transform: uppercase;
    }

    .cd-header h2 {
        font-size: 31px;
        font-weight: 850;
        margin: 8px 0;
        letter-spacing: -1.2px;
    }

    .cd-dot {
        color: #999;
    }

    .cd-subtitle {
        font-size: 13px;
        color: #777;
        margin: 0;
    }

    .cd-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
    }

    .cd-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 17px;
        border: 1px solid #dedede;
        border-radius: 8px;
        background: white;
        color: #161616;
        font-size: 12px;
        font-weight: 750;
        text-decoration: none;
        cursor: pointer;
        transition: .2s;
    }

        .cd-btn:hover {
            background: #f2f2f2;
            color: #111;
        }

    .cd-btn-dark {
        background: #171717;
        border-color: #171717;
        color: white;
    }

        .cd-btn-dark:hover {
            background: #383838;
            color: white;
        }

    .cd-btn-danger {
        color: #a72c2c;
        border-color: #f0d3d3;
    }

        .cd-btn-danger:hover {
            background: #fff1f1;
            color: #a72c2c;
        }

    .cd-profile {
        background: #fff;
        border: 1px solid #e9e9e9;
        border-radius: 14px;
        padding: 28px;
        margin-bottom: 20px;
    }

    .cd-profile-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
    }

    .cd-profile-user {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .cd-avatar {
        width: 72px;
        height: 72px;
        flex-shrink: 0;
        background: #161616;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 30px;
        font-weight: 800;
    }

    .cd-profile-user h3 {
        font-size: 21px;
        font-weight: 800;
        margin: 0 0 6px;
    }

    .cd-profile-user p {
        margin: 0;
        color: #777;
        font-size: 13px;
    }

    .cd-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 750;
        padding: 8px 12px;
    }

        .cd-badge.active {
            background: #e8f6eb;
            color: #267c3b;
        }

        .cd-badge.inactive {
            background: #f8eaea;
            color: #9c3030;
        }

    .cd-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 16px;
        margin-bottom: 20px;
    }

    .cd-stat {
        background: #fff;
        border: 1px solid #e9e9e9;
        border-radius: 12px;
        padding: 23px;
    }

        .cd-stat small {
            font-size: 10px;
            letter-spacing: 1.4px;
            font-weight: 800;
            color: #888;
        }

        .cd-stat strong {
            display: block;
            font-size: 29px;
            font-weight: 850;
            margin: 10px 0 5px;
            letter-spacing: -1px;
            overflow-wrap: anywhere;
        }

        .cd-stat span {
            font-size: 11px;
            color: #888;
        }

    .cd-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 20px;
        margin-bottom: 20px;
    }

    .cd-panel {
        min-width: 0;
        background: #fff;
        border: 1px solid #e9e9e9;
        border-radius: 12px;
        padding: 24px;
    }

    .cd-panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #eee;
        padding-bottom: 16px;
        margin-bottom: 18px;
    }

        .cd-panel-head h3 {
            margin: 0;
            font-size: 15px;
            font-weight: 800;
        }

    .cd-field {
        padding: 12px 0;
        border-bottom: 1px solid #f0f0f0;
    }

        .cd-field:last-child {
            border-bottom: 0;
        }

        .cd-field small {
            display: block;
            color: #999;
            font-size: 10px;
            font-weight: 750;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        .cd-field strong {
            display: block;
            font-size: 13px;
            font-weight: 650;
            overflow-wrap: anywhere;
        }

    .cd-address {
        border: 1px solid #eaeaea;
        padding: 18px;
        border-radius: 9px;
        margin-bottom: 12px;
    }

        .cd-address:last-child {
            margin-bottom: 0;
        }

        .cd-address h4 {
            margin: 0 0 8px;
            font-size: 13px;
            font-weight: 800;
        }

        .cd-address p {
            margin: 4px 0;
            font-size: 12px;
            color: #666;
            line-height: 1.7;
        }

    .cd-default {
        font-size: 10px;
        background: #171717;
        color: #fff;
        padding: 4px 9px;
        border-radius: 20px;
        margin-left: 8px;
    }

    .cd-table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .cd-table {
        width: 100%;
        border-collapse: collapse;
        white-space: nowrap;
    }

        .cd-table th {
            font-size: 10px;
            font-weight: 800;
            color: #888;
            letter-spacing: 1px;
            background: #f7f7f7;
            padding: 15px;
            text-align: left;
        }

        .cd-table td {
            padding: 16px 15px;
            border-bottom: 1px solid #eee;
            font-size: 12px;
        }

        .cd-table tbody tr:last-child td {
            border-bottom: 0;
        }

    .cd-empty {
        padding: 35px 15px;
        text-align: center;
        color: #888;
        font-size: 13px;
    }

    .cd-alert {
        background: #fff7f7;
        color: #a62b2b;
        border: 1px solid #f0cece;
        padding: 14px 18px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 13px;
    }

    .cd-alert-success {
        background: #edf9f0;
        color: #216e36;
        border-color: #cae9d1;
    }

    .cd-footer-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-top: 20px;
    }

    @@media(max-width: 850px) {
        .cd-grid {
            grid-template-columns: 1fr;
        }

        .cd-stats {
            grid-template-columns: 1fr;
        }

        .cd-header h2 {
            font-size: 26px;
        }

        .cd-profile {
            padding: 20px;
        }

        .cd-panel {
            padding: 18px;
        }

        .cd-profile-user {
            align-items: flex-start;
        }
    }
</style>

<div class="cd-page">

    <!-- HEADER -->
    <div class="cd-header">
        <div>
            <div class="cd-eyebrow">
                ADMIN / CUSTOMERS / DETAILS
            </div>

            <h2>
                Customer details<span class="cd-dot">.</span>
            </h2>

            <p class="cd-subtitle">
                Review customer profile, account access,
                order history and addresses.
            </p>
        </div>

        <div class="cd-actions">
            <a href="@indexUrl" class="cd-btn">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>

            <a href="@editUrl" class="cd-btn cd-btn-dark">
                <i class="bi bi-pencil-square"></i>
                Edit Customer
            </a>
        </div>
    </div>

    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="cd-alert cd-alert-success" role="status">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="cd-alert" role="alert">
            @TempData["Error"]
        </div>
    }

    <!-- PROFILE -->
    <div class="cd-profile">
        <div class="cd-profile-top">

            <div class="cd-profile-user">
                <div class="cd-avatar">@initials</div>

                <div>
                    <h3>@Model.FullName</h3>
                    <p>@Model.Email</p>
                    <p style="margin-top:7px;">
                        Member since
                        @Model.CreatedAt.ToString("dd MMM yyyy")
                    </p>
                </div>
            </div>

            <span class="cd-badge @(Model.IsActive ? "active" : "inactive")">
                <i class="bi @(Model.IsActive ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                @(Model.IsActive ? "Active Account" : "Inactive Account")
            </span>

        </div>
    </div>

    <!-- STATISTICS -->
    <div class="cd-stats">

        <div class="cd-stat">
            <small>TOTAL ORDERS</small>
            <strong>@Model.TotalOrders</strong>
            <span>Orders placed by this customer</span>
        </div>

        <div class="cd-stat">
            <small>TOTAL SPENT</small>
            <strong>৳@Model.TotalSpent.ToString("N2")</strong>
            <span>Lifetime order value</span>
        </div>

        <div class="cd-stat">
            <small>ACCOUNT STATUS</small>
            <strong>@(Model.IsActive ? "Active" : "Inactive")</strong>
            <span>
                @(Model.IsActive ? "Account enabled" : "Account disabled")
            </span>
        </div>

    </div>

    <!-- PROFILE DETAILS -->
    <div class="cd-grid">

        <!-- PERSONAL INFORMATION -->
        <section class="cd-panel">

            <div class="cd-panel-head">
                <h3>
                    <i class="bi bi-person"></i>
                    Personal Information
                </h3>
            </div>

            <div class="cd-field">
                <small>Full Name</small>
                <strong>@Model.FullName</strong>
            </div>

            <div class="cd-field">
                <small>Email Address</small>
                <strong>@Model.Email</strong>
            </div>

            <div class="cd-field">
                <small>Phone Number</small>
                <strong>
                    @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                        ? "Not provided"
                        : Model.PhoneNumber)
                </strong>
            </div>

            <div class="cd-field">
                <small>Registration Date</small>
                <strong>
                    @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                </strong>
            </div>

        </section>

        <!-- ACCOUNT INFORMATION -->
        <section class="cd-panel">

            <div class="cd-panel-head">
                <h3>
                    <i class="bi bi-shield-check"></i>
                    Account Information
                </h3>
            </div>

            <div class="cd-field">
                <small>Account Status</small>
                <strong>
                    @(Model.IsActive ? "Active" : "Inactive")
                </strong>
            </div>

            <div class="cd-field">
                <small>Email Verification</small>
                <strong>
                    @(Model.EmailConfirmed ? "Verified" : "Not Verified")
                </strong>
            </div>

            <div class="cd-field">
                <small>Customer ID</small>
                <strong>@Model.Id</strong>
            </div>

            <div class="cd-field">
                <small>Account Type</small>
                <strong>Customer</strong>
            </div>

        </section>
    </div>

    <!-- SAVED ADDRESSES -->
    <section class="cd-panel" style="margin-bottom:20px;">

        <div class="cd-panel-head">
            <h3>
                <i class="bi bi-geo-alt"></i>
                Saved Addresses
            </h3>

            <span style="font-size:12px;color:#888;">
                @(Model.Addresses?.Count ?? 0) Addresses
            </span>
        </div>

        @if (Model.Addresses != null && Model.Addresses.Any())
        {
            @foreach (var address in Model.Addresses)
            {
                <div class="cd-address">

                    <h4>
                        @address.FullName

                        @if (address.IsDefault)
                        {
                            <span class="cd-default">
                                Default
                            </span>
                        }
                    </h4>

                    <p>
                        <i class="bi bi-telephone"></i>
                        @address.PhoneNumber
                    </p>

                    <p>
                        @address.AddressLine1
                    </p>

                    @if (!string.IsNullOrWhiteSpace(address.AddressLine2))
                    {
                        <p>@address.AddressLine2</p>
                    }

                    <p>
                        @address.City,
                        @address.District
                        @address.PostalCode
                    </p>

                    <p>@address.Country</p>

                </div>
            }
        }
        else
        {
            <div class="cd-empty">
                <i class="bi bi-geo-alt"
                   style="font-size:27px;"></i>
                <p style="margin-top:12px;">
                    No saved addresses found.
                </p>
            </div>
        }

    </section>

    <!-- RECENT ORDERS -->
    <section class="cd-panel">

        <div class="cd-panel-head">
            <h3>
                <i class="bi bi-bag-check"></i>
                Recent Orders
            </h3>
        </div>

        <div class="cd-table-wrap">
            <table class="cd-table">

                <thead>
                    <tr>
                        <th>ORDER NUMBER</th>
                        <th>DATE</th>
                        <th>STATUS</th>
                        <th>AMOUNT</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.RecentOrders != null &&
                         Model.RecentOrders.Any())
                    {
                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr>
                                <td>
                                    <strong>@order.OrderNumber</strong>
                                </td>

                                <td>
                                    @order.CreatedAt.ToString("dd MMM yyyy")
                                </td>

                                <td>@order.Status</td>

                                <td>
                                    <strong>
                                        ৳@order.TotalAmount.ToString("N2")
                                    </strong>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="cd-empty">
                                No orders placed yet.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>
        </div>

    </section>

    <!-- ACCOUNT MANAGEMENT -->
    <div class="cd-footer-actions">

        <form action="@toggleUrl" method="post">
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="cd-btn"
                    onclick="return confirm('Change this customer account status?');">

                <i class="bi bi-power"></i>

                @(Model.IsActive
                    ? "Deactivate Account"
                    : "Activate Account")
            </button>
        </form>

        <form action="@deleteUrl"
              method="post"
              onsubmit="return confirm('Permanently delete this customer? This action cannot be undone.');">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="cd-btn cd-btn-danger">
                <i class="bi bi-trash"></i>
                Delete Customer
            </button>

        </form>

    </div>

</div>
