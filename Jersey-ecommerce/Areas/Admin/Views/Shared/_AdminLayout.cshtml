
@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var adminName = User.Identity?.Name ?? "Administrator";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle | PANENKA Admin</title>
    <meta name="robots" content="noindex, nofollow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="~/assets/brands/panekalogo.jpeg" />
    <link rel="shortcut icon" href="~/assets/brands/panekalogo.jpeg" />
    <link rel="apple-touch-icon" href="~/assets/brands/panekalogo.jpeg" />
    <meta name="theme-color" content="#111111" />
    <style>
        :root {
            --admin-sidebar: #101010;
            --admin-sidebar-hover: #252525;
            --admin-sidebar-text: #b5b5b5;
            --admin-accent: #ffffff;
            --admin-accent-hover: #e5e5e5;
            --admin-bg: #f5f5f5;
            --admin-card: #ffffff;
            --admin-text: #111111;
            --admin-muted: #777777;
            --admin-border: #e7e7e7;
            --admin-sidebar-width: 260px;
            --admin-topbar-height: 74px;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        html, body {
            min-height: 100%;
            margin: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--admin-bg);
            color: var(--admin-text);
            font-size: 14px;
        }

        a {
            text-decoration: none;
        }

        /* Sidebar */
        .admin-sidebar {
            position: fixed;
            inset: 0 auto 0 0;
            width: var(--admin-sidebar-width);
            background: var(--admin-sidebar);
            color: #fff;
            display: flex;
            flex-direction: column;
            z-index: 1040;
            overflow: hidden;
            border: 0 !important;
            outline: 0 !important;
            box-shadow: none !important;
            transition: transform .25s ease;
        }

        .admin-brand {
            min-height: var(--admin-topbar-height);
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 22px;
            border: 0;
            border-bottom: 1px solid rgba(255,255,255,.10);
            color: #fff;
            flex-shrink: 0;
        }

        .admin-brand:hover {
            color: #fff;
        }

        .admin-brand-mark {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
}

.admin-brand-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
}

        .admin-brand-name {
            display: block;
            font-size: 19px;
            line-height: 1.15;
            font-weight: 900;
            letter-spacing: -1px;
        }

        .admin-brand-name span {
            color: #999;
        }

        .admin-brand-caption {
            display: block;
            color: #999;
            font-size: 9px;
            font-weight: 600;
            margin-top: 5px;
            letter-spacing: 1.8px;
            text-transform: uppercase;
        }

        .admin-sidebar-content {
            flex: 1;
            min-height: 0;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 18px 13px;
            scrollbar-width: none !important;
            -ms-overflow-style: none !important;
            border: 0 !important;
            box-shadow: none !important;
        }

        .admin-sidebar-content::-webkit-scrollbar,
        .admin-sidebar::-webkit-scrollbar {
            display: none !important;
            width: 0 !important;
            height: 0 !important;
        }

        .admin-section-label {
            padding: 18px 12px 9px;
            color: #777;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 1.7px;
            text-transform: uppercase;
        }

        .admin-nav-link {
            min-height: 43px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 13px;
            margin: 3px 0;
            border-radius: 0;
            color: var(--admin-sidebar-text);
            font-size: 12px;
            font-weight: 600;
            border-left: 2px solid transparent;
            transition: background .18s, color .18s, border-color .18s;
        }

        .admin-nav-link i {
            width: 20px;
            font-size: 16px;
            text-align: center;
            flex-shrink: 0;
        }

        .admin-nav-link:hover {
            background: #202020;
            color: #fff;
        }

        .admin-nav-link.active {
            background: #fff;
            color: #111;
            border-left-color: #111;
            font-weight: 800;
            box-shadow: none;
        }

        .admin-sidebar-footer {
            padding: 14px 15px;
            border: 0;
            border-top: 1px solid rgba(255,255,255,.10);
            flex-shrink: 0;
        }

        .store-status {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 11px;
            background: #1b1b1b;
            color: #ccc;
            font-size: 11px;
        }

        .status-dot {
            width: 7px;
            height: 7px;
            background: #fff;
            border-radius: 50%;
            flex-shrink: 0;
        }

        /* Main content */
        .admin-main {
            min-height: 100vh;
            margin-left: var(--admin-sidebar-width);
            display: flex;
            flex-direction: column;
            border: 0 !important;
            box-shadow: none !important;
            min-width: 0;
        }

        .admin-topbar {
            position: sticky;
            top: 0;
            z-index: 1020;
            min-height: var(--admin-topbar-height);
            background: rgba(255,255,255,.97);
            border: 0;
            border-bottom: 1px solid var(--admin-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            padding: 12px 30px;
            backdrop-filter: blur(12px);
        }

        .admin-topbar-left,
        .admin-topbar-right {
            display: flex;
            align-items: center;
            gap: 15px;
            min-width: 0;
        }

        .admin-page-heading {
            font-size: 16px;
            font-weight: 850;
            margin: 0;
            letter-spacing: -.5px;
        }

        .admin-breadcrumb {
            margin-top: 5px;
            color: var(--admin-muted);
            font-size: 10px;
        }

        .admin-search {
            width: min(270px, 27vw);
            position: relative;
        }

        .admin-search > i {
            position: absolute;
            top: 50%;
            left: 13px;
            transform: translateY(-50%);
            color: #888;
        }

        .admin-search input {
            width: 100%;
            height: 39px;
            padding: 0 13px 0 37px;
            border: 1px solid #dedede;
            border-radius: 0;
            outline: none;
            background: #fafafa;
            font: inherit;
            font-size: 11px;
        }

        .admin-search input:focus {
            border-color: #111;
            box-shadow: none;
        }

        .admin-icon-button {
            width: 39px;
            height: 39px;
            display: grid;
            place-items: center;
            border: 1px solid #dedede;
            border-radius: 0;
            background: #fff;
            color: #111;
            font-size: 17px;
        }

        .admin-icon-button:hover {
            background: #eee;
        }

        .admin-profile {
            display: flex;
            align-items: center;
            gap: 10px;
            padding-left: 15px;
            border-left: 1px solid var(--admin-border);
        }

        .admin-avatar {
            width: 36px;
            height: 36px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: #111;
            color: #fff;
            font-weight: 800;
            font-size: 12px;
            flex-shrink: 0;
        }

        .admin-profile-name {
            font-size: 11px;
            font-weight: 800;
            max-width: 150px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .admin-profile-role {
            margin-top: 3px;
            color: var(--admin-muted);
            font-size: 10px;
        }

        .admin-content {
            flex: 1;
            padding: 28px 30px;
            width: 100%;
            min-width: 0;
        }

        .admin-footer {
            padding: 17px 30px;
            color: var(--admin-muted);
            font-size: 10px;
            border: 0;
            border-top: 1px solid var(--admin-border);
            background: #fff;
        }

        .admin-overlay {
            display: none;
        }

        .admin-mobile-toggle {
            display: none;
        }

        .admin-content .card {
            border-radius: 0;
        }

        .admin-content .table > :not(caption) > * > * {
            padding: 14px 16px;
            border-bottom-color: var(--admin-border);
        }

        .admin-content .table thead th {
            color: #777;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .8px;
        }

        .dropdown-menu {
            border-radius: 0;
            font-size: 12px;
        }

        .dropdown-item {
            padding: 10px 12px;
        }

        @@media (max-width: 991.98px) {
            .admin-sidebar {
                transform: translateX(-100%);
            }

            body.admin-sidebar-open .admin-sidebar {
                transform: translateX(0);
            }

            .admin-main {
                margin-left: 0;
            }

            .admin-mobile-toggle {
                display: grid;
            }

            .admin-overlay {
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,.55);
                z-index: 1030;
            }

            body.admin-sidebar-open .admin-overlay {
                display: block;
            }

            .admin-topbar {
                padding: 12px 20px;
            }

            .admin-content {
                padding: 24px 20px;
            }
        }

        @@media (max-width: 575.98px) {
            .admin-search,
            .admin-profile-details {
                display: none;
            }

            .admin-topbar {
                padding: 12px 14px;
                gap: 8px;
            }

            .admin-topbar-left,
            .admin-topbar-right {
                gap: 9px;
            }

            .admin-content {
                padding: 19px 13px;
            }

            .admin-footer {
                padding: 15px;
            }

            .admin-profile {
                padding-left: 8px;
            }
        }
    </style>

    <link rel="stylesheet" href="~/css/panenka-premium.css" asp-append-version="true" />
    <script src="~/js/panenka-polish.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <aside class="admin-sidebar" id="adminSidebar">
        <a asp-area="Admin"
           asp-controller="Dashboard"
           asp-action="Index"
           class="admin-brand">
           <span class="admin-brand-mark">
        <img src="~/assets/brands/panekalogo.jpeg"
             alt="PANENKA Logo"
             class="admin-brand-logo" />
    </span>
            <span>
                <span class="admin-brand-name">PANENKA<span>.</span></span>
                <span class="admin-brand-caption">Football Culture</span>
            </span>
        </a>

        <div class="admin-sidebar-content">
            <div class="admin-section-label">Overview</div>

            <a href="/admin/dashboard"
               class="admin-nav-link @(currentController == "Dashboard" ? "active" : "")">
                <i class="bi bi-grid-1x2"></i><span>Dashboard</span>
            </a>

            <div class="admin-section-label">Catalog</div>

            <a href="/admin/products"
               class="admin-nav-link @(currentController == "Products" ? "active" : "")">
                <i class="bi bi-box-seam"></i><span>Products</span>
            </a>

            <a href="/admin/categories"
               class="admin-nav-link @(currentController == "Categories" ? "active" : "")">
                <i class="bi bi-grid"></i><span>Categories</span>
            </a>

            <a href="/admin/brands"
               class="admin-nav-link @(currentController == "Brands" ? "active" : "")">
                <i class="bi bi-tags"></i><span>Brands</span>
            </a>

            <a href="/admin/collections"
               class="admin-nav-link @(currentController == "Collections" ? "active" : "")">
                <i class="bi bi-collection"></i><span>Collections</span>
            </a>

            <a href="/admin/variants"
               class="admin-nav-link @(currentController == "Variants" ? "active" : "")">
                <i class="bi bi-palette"></i><span>Sizes &amp; Colors</span>
            </a>

            <div class="admin-section-label">Sales</div>

            <a href="/admin/orders"
               class="admin-nav-link @(currentController == "Orders" ? "active" : "")">
                <i class="bi bi-receipt"></i><span>Orders</span>
            </a>

            <a href="/admin/payments"
               class="admin-nav-link @(currentController == "Payments" ? "active" : "")">
                <i class="bi bi-credit-card"></i><span>Payments</span>
            </a>

            <a href="/Admin/CheckoutPaymentReview"
               class="admin-nav-link @(currentController == "CheckoutPaymentReview" ? "active" : "")">
                <i class="bi bi-shield-check"></i><span>Verify bKash</span>
            </a>

            <a href="/admin/shipments"
               class="admin-nav-link @(currentController == "Shipments" ? "active" : "")">
                <i class="bi bi-truck"></i><span>Shipments</span>
            </a>

            <div class="admin-section-label">Customers &amp; Marketing</div>

            <a href="/admin/customers"
               class="admin-nav-link @(currentController == "Customers" ? "active" : "")">
                <i class="bi bi-people"></i><span>Customers</span>
            </a>

            <a href="/admin/reviews"
               class="admin-nav-link @(currentController == "Reviews" ? "active" : "")">
                <i class="bi bi-star"></i><span>Reviews</span>
            </a>

            <a href="/admin/coupons"
               class="admin-nav-link @(currentController == "Coupons" ? "active" : "")">
                <i class="bi bi-ticket-perforated"></i><span>Coupons</span>
            </a>

            <a href="/admin/banners"
               class="admin-nav-link @(currentController == "Banners" ? "active" : "")">
                <i class="bi bi-images"></i><span>Banners &amp; Slides</span>
            </a>

            <div class="admin-section-label">Store Settings</div>

            <a href="/admin/settings"
               class="admin-nav-link @(currentController == "Settings" ? "active" : "")">
                <i class="bi bi-gear"></i><span>Settings</span>
            </a>

            <a href="/"
               class="admin-nav-link">
                <i class="bi bi-box-arrow-up-right"></i><span>View Store</span>
            </a>
        </div>

        <div class="admin-sidebar-footer">
            <div class="store-status">
                <span class="status-dot"></span>
                <span>PANENKA administration</span>
            </div>
        </div>
    </aside>

    <div class="admin-overlay" id="adminOverlay"></div>

    <main class="admin-main">
        <header class="admin-topbar">
            <div class="admin-topbar-left">
                <button type="button"
                        class="admin-icon-button admin-mobile-toggle"
                        id="adminMenuToggle"
                        aria-label="Toggle navigation"
                        aria-controls="adminSidebar"
                        aria-expanded="false">
                    <i class="bi bi-list"></i>
                </button>

                <div>
                    <h1 class="admin-page-heading">@pageTitle</h1>
                    <p class="admin-breadcrumb mb-0">
                        PANENKA / Administration / @pageTitle
                    </p>
                </div>
            </div>

            <div class="admin-topbar-right">
                <form class="admin-search"
                      asp-area="Admin"
                      asp-controller="Products"
                      asp-action="Index"
                      method="get"
                      role="search">
                    <i class="bi bi-search"></i>
                    <input type="search"
                           name="search"
                           placeholder="Search products..."
                           aria-label="Search products" />
                </form>

                <div class="dropdown">
                    <button type="button"
                            class="admin-icon-button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            aria-label="Account menu">
                        <i class="bi bi-person"></i>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 p-2">
                        <li>
                            <span class="dropdown-item-text small text-secondary">
                                Signed in as @adminName
                            </span>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <a class="dropdown-item rounded"
                               href="/Account/Profile">
                                <i class="bi bi-person me-2"></i>Account
                            </a>
                        </li>
                        <li>

                            <form method="post"
                                  action="@Url.Action("Logout", "Account", new { area = "" })">
                                @Html.AntiForgeryToken()

                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    Sign out
                                </button>
                            </form>

                        </li>
                    </ul>
                </div>

                <div class="admin-profile">
                    <div class="admin-avatar">
                        @(string.IsNullOrWhiteSpace(adminName)
                            ? "A"
                            : adminName.Substring(0, 1).ToUpperInvariant())
                    </div>
                    <div class="admin-profile-details">
                        <div class="admin-profile-name">@adminName</div>
                        <div class="admin-profile-role">Administrator</div>
                    </div>
                </div>
            </div>
        </header>

        <section class="admin-content">
            @RenderBody()
        </section>

        <footer class="admin-footer d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; @DateTime.Now.Year PANENKA</span>
            <span>Football, beyond the ordinary.</span>
        </footer>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (() => {
            const toggle = document.getElementById('adminMenuToggle');
            const overlay = document.getElementById('adminOverlay');

            function setSidebar(open) {
                document.body.classList.toggle('admin-sidebar-open', open);
                toggle?.setAttribute('aria-expanded', String(open));
            }

            toggle?.addEventListener('click', () => {
                setSidebar(!document.body.classList.contains('admin-sidebar-open'));
            });

            overlay?.addEventListener('click', () => setSidebar(false));

            document.addEventListener('keydown', event => {
                if (event.key === 'Escape') setSidebar(false);
            });

            document.querySelectorAll('.admin-nav-link').forEach(link => {
                link.addEventListener('click', () => setSidebar(false));
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
